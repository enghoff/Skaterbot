// Wheel adapter -- the printed part that turns the ankle actuator into a wheel
// drive
//
// The walking foot took the rotor's output down through an offset arm and a
// bridge, because a flat sole has to be brought back under the leg centre line.
// A wheel does not, so this part is the shared output disc from joint.kcl and
// nothing else but a spigot: the load plane stays as close to the actuator's
// own output bearing as the motor body allows.
//
// HOW THE WHEEL IS HELD. The donor skate wheel arrives with two 608 bearings
// pressed into its hub. They come out and are thrown away -- there is no second
// bearing race in a direct drive, the actuator's output bearing is the only one
// -- which leaves a clean Ø22 bore through the hub. The spigot fills it, the hub
// lands flat on the output disc, and one M5 on the axis pulls the two together
// through a washer.
//
// Torque crosses that clamped face by friction, not through the spigot. An M5 at
// a modest 1 kN of preload on the disc's r11-r18 annulus is worth about 4 Nm,
// against the DM-J3507's 3 Nm peak. A press fit on the spigot alone would have
// depended on how the print came off the bed, which is not a thing to hang the
// drive on. The arithmetic is in wheeled_parameters.kcl.
//
// Left as interpenetrating bodies rather than one union, for the reason
// NOTES.md and docs/KCL_GOTCHAS.md record: the engine refuses some of these
// unions, and a union onto a drilled disc has silently filled its holes back in
// before now. Every overlap here is millimetres of real solid, so a slicer that
// merges coincident shells prints this as the single part it is.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions and the shared drawing functions, reached through lib/main.kcl
import * from "lib/main.kcl"

spigotInnerX = rotorHubOuterX
spigotOuterX = rotorHubOuterX + wheelSpigotLength
spigotCenterX = (spigotInnerX + spigotOuterX) / 2

// The plug reaches 2 mm back into the disc and 4 mm out past the spigot's root,
// so both joints in the chain are a real overlap rather than a butted face.
plugInnerX = rotorHubOuterX - 2mm
plugOuterX = rotorHubOuterX + 4mm
plugCenterX = (plugInnerX + plugOuterX) / 2

insertOuterX = spigotOuterX
insertInnerX = spigotOuterX - wheelSpigotInsertDepth

adapterDiscRaw = outputDisc()

// ---- spigot ----------------------------------------------------------------


spigotSketch = sketch(on = YZ) {
  spigotCircle = circle(start = [var 11mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([spigotCircle.center, ORIGIN])
  horizontal([
    spigotCircle.center,
    spigotCircle.start
  ])
  diameter(spigotCircle) == wheelSpigotDiameter
}
spigotRegion = region(segments = [spigotSketch.spigotCircle])
spigotBlank = extrude(spigotRegion, length = wheelSpigotLength, symmetric = true)
  |> translate(x = spigotCenterX, global = true)

// ---- key access ------------------------------------------------------------
// Six cutters on the output bolt centres, run past both ends of the spigot so
// that no wall of the cut is coplanar with a face of the body it crosses --
// docs/KCL_GOTCHAS.md lists coincident walls as a reliable way to have a
// boolean refused.


keyAccessSketch = sketch(on = YZ) {
  keyCircle = circle(start = [var 2.25mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([keyCircle.center, ORIGIN])
  horizontal([keyCircle.center, keyCircle.start])
  diameter(keyCircle) == wheelKeyAccessDiameter
}
keyAccessRegion = region(segments = [keyAccessSketch.keyCircle])
keyCut1 = extrude(keyAccessRegion, length = wheelSpigotLength + 4mm, symmetric = true)
  |> translate(x = spigotCenterX, y = actuatorOutputBoltCircle / 2, global = true)
keyCut2 = clone(keyCut1)
  |> rotate(axis = [1, 0, 0], angle = 60deg, global = true)
keyCut3 = clone(keyCut1)
  |> rotate(axis = [1, 0, 0], angle = 120deg, global = true)
keyCut4 = clone(keyCut1)
  |> rotate(axis = [1, 0, 0], angle = 180deg, global = true)
keyCut5 = clone(keyCut1)
  |> rotate(axis = [1, 0, 0], angle = 240deg, global = true)
keyCut6 = clone(keyCut1)
  |> rotate(axis = [1, 0, 0], angle = 300deg, global = true)

spigotAfterKeyAccess = subtract(
  spigotBlank,
  tools = [
    keyCut1,
    keyCut2,
    keyCut3,
    keyCut4,
    keyCut5,
    keyCut6
  ],
)

// ---- clamp insert ----------------------------------------------------------


insertSketch = sketch(on = YZ) {
  insertCircle = circle(start = [var 3.2mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([insertCircle.center, ORIGIN])
  horizontal([
    insertCircle.center,
    insertCircle.start
  ])
  diameter(insertCircle) == wheelSpigotInsertBore
}
insertRegion = region(segments = [insertSketch.insertCircle])
insertCutter = extrude(insertRegion, length = wheelSpigotInsertDepth + 2mm, symmetric = true)
  |> translate(x = insertInnerX + (wheelSpigotInsertDepth + 2mm) / 2 - 2mm, global = true)

spigotRaw = subtract(spigotAfterKeyAccess, tools = [insertCutter])

// ---- plug ------------------------------------------------------------------


plugSketch = sketch(on = YZ) {
  plugCircle = circle(start = [var 8.5mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([plugCircle.center, ORIGIN])
  horizontal([plugCircle.center, plugCircle.start])
  diameter(plugCircle) == wheelSpigotPlugDiameter
}
plugRegion = region(segments = [plugSketch.plugCircle])
plugRaw = extrude(plugRegion, length = plugOuterX - plugInnerX, symmetric = true)
  |> translate(x = plugCenterX, global = true)

hide(spigotSketch)
hide(keyAccessSketch)
hide(insertSketch)
hide(plugSketch)

// The two hands. The robot is mirror-symmetric about its midline, so this part
// exists left and right. `mirror3d` copies rather than transforms -- it leaves
// the original standing in the scene -- so the source is hidden afterwards.
// See docs/KCL_GOTCHAS.md.
export wheelAdapterRight = appearance(
  [adapterDiscRaw, spigotRaw, plugRaw],
  color = printedOrange,
  roughness = 70,
  metalness = 3,
)

wheelAdapterMirrorSource = clone(wheelAdapterRight)
export wheelAdapterLeft = mirror3d(wheelAdapterMirrorSource, across = YZ)
hide(wheelAdapterMirrorSource)
