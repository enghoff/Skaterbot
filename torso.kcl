// Pelvis and torso shell
//
// One closed box from the hip pitch axes to the cover, and the two hip PITCH
// actuators hang straight off its floor. There is no hip roll joint on this
// robot and no carrier between the torso and the thigh: what used to be an
// actuator, a bearing set and an orthogonal printed carrier at the top of each
// leg is now the same stator clevis, rooted in the shell.
//
// The walking robot still has hip roll, and its pelvis is walking_torso.kcl
// beside this file. The lid and the four cover bosses are one design at two
// sizes and come from torso_shell.kcl.
//
// WHY THE SHAPE IS WHAT IT IS
//
// It is the shape hip roll used to forbid. Those two actuators owned the outer
// thirds of the torso -- a Ø46 body fills 278 to 324 mm at |x| between 25 and
// 71, and the clevis cheeks reached in to |x| = 22 -- so the pelvis had to be
// two things stacked: a 44 mm KEEL squeezed between them from the torso bottom
// up, and a full-width SHELL clear above them. The keel existed only because
// the actuators were in the way, and with them gone the shell simply runs down
// to the torso bottom at full width.
//
// WHY IT IS 125 x 68 x 65 AND NOT 118 x 68 x 106
//
// The floor is pinned: one joint keep-out above the hip pitch axis, because that
// floor is the seat the two hip clevises are rooted in. Everything else is set
// by what has to fit inside, and wheeled_parameters.kcl carries the arithmetic.
// The short version is that the power-entry block and the controller carrier sit
// SIDE BY SIDE rather than stacked, which needs 114 mm of interior and is the
// whole reason the box is 7 mm wider than the walking robot's. Buying that width
// took 14 mm off the height, and the robot is 148 mm across at the hip saddles
// anyway, so the torso is not what makes it wide.
//
// The saddles are why the payload starts 9 mm up rather than on the floor. They
// stand that far proud across |x| = 26 to 60, leaving 51.5 mm of clear floor
// between them, which is where the IMU goes -- the stiffest spot in the pelvis
// and directly between the two hip joints.
//
// STIFFNESS
// The keel was a channel, a 68 x 3 floor flange over two 2.4 mm webs 51 mm
// deep, worth about 98 000 mm^4 in roll about its own centroid. Over that same
// 51 mm the box replacing it is 125 x 68 closed, which is worth of order a
// hundred times more again. That is arithmetic and not measurement, like every
// other section number in this project, and it inherits whatever the Phase 1
// coupon says about modulus. The point is not the figure: it is that the pelvis
// got stiffer in the one axis it lost a motor in.
//
// WHAT IT COSTS
// Lateral balance. Nothing on the robot can roll the torso over a wheel any
// more, so it leans only by driving the two wheels differentially and it cannot
// place a wheel sideways at all. That was the trade the six-motor study weighed
// in docs/WHEELED_BIPED_ANALYSIS.md section 11, and this file is what taking it
// looks like.
//
// The hip clevis cheeks are Ø52 discs centred on the leg axes, so they still
// reach 74 mm from the centre line and the robot is still 148 mm across at the
// hips. The joints are the visible hardware, the shell is not.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions and the shared drawing functions, reached through lib/main.kcl
import * from "lib/main.kcl"

// Every station is derived from the kinematics rather than typed in, so moving
// the hip pitch axis or the actuator diameter moves the whole shell with it.
// The floor is one joint keep-out above hip pitch and nothing else; the torso
// bottom follows it rather than the other way round.
torsoShellWidth = wheeledTorsoShellWidth
torsoInnerWidth = torsoShellWidth - (shellWall * 2)
torsoInnerDepth = torsoShellDepth - (shellWall * 2)
floorThickness = torsoFloorThickness

hipPitchZ = wheeledHipPitchAxisHeight - wheeledTorsoCenterHeight
shellFloorZ = hipPitchZ + jointKeepOut
saddleTopZ = shellFloorZ + saddleHeight

shellTopZ = wheeledTorsoHeight / 2 - torsoCoverThickness
shellHeight = shellTopZ - shellFloorZ
shellCenterZ = (shellFloorZ + shellTopZ) / 2
cavityBottomZ = shellFloorZ + floorThickness
cavityLength = shellTopZ + 2mm - cavityBottomZ

// ---- shell ------------------------------------------------------------------


shellOuterSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 118mm, var 0mm])
  edge2 = line(start = [var 118mm, var 0mm], end = [var 118mm, var 68mm])
  edge3 = line(start = [var 118mm, var 68mm], end = [var 0mm, var 68mm])
  edge4 = line(start = [var 0mm, var 68mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == torsoShellWidth
  verticalDistance([edge2.start, edge2.end]) == torsoShellDepth
}
shellOuterRegion = region(
  segments = [
    shellOuterSketch.edge1,
    shellOuterSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
shellBlank = extrude(shellOuterRegion, length = shellHeight, symmetric = true)
  |> translate(
       x = -torsoShellWidth / 2,
       y = -torsoShellDepth / 2,
       z = shellCenterZ,
       global = true,
     )

shellInnerSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 113mm, var 0mm])
  edge2 = line(start = [var 113mm, var 0mm], end = [var 113mm, var 63mm])
  edge3 = line(start = [var 113mm, var 63mm], end = [var 0mm, var 63mm])
  edge4 = line(start = [var 0mm, var 63mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == torsoInnerWidth
  verticalDistance([edge2.start, edge2.end]) == torsoInnerDepth
}
shellInnerRegion = region(
  segments = [
    shellInnerSketch.edge1,
    shellInnerSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
shellCavity = extrude(shellInnerRegion, length = cavityLength, symmetric = true)
  |> translate(
       x = -torsoInnerWidth / 2,
       y = -torsoInnerDepth / 2,
       z = cavityBottomZ + cavityLength / 2,
       global = true,
     )

// Rectangular rather than round, and deliberately so: the engine will not take
// a blind cylindrical pocket out of this box, though it takes a rectangular one
// happily -- the same limitation NOTES.md records for the tube bleed holes. A
// slot suits a cable with a moulded connector better than a grommet hole anyway.
cablePortSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 14mm, var 0mm])
  edge2 = line(start = [var 14mm, var 0mm], end = [var 14mm, var 10mm])
  edge3 = line(start = [var 14mm, var 10mm], end = [var 0mm, var 10mm])
  edge4 = line(start = [var 0mm, var 10mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == cablePortWidth
  verticalDistance([edge2.start, edge2.end]) == cablePortDepth
}
cablePortRegion = region(
  segments = [
    cablePortSketch.edge1,
    cablePortSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
rightCablePort = extrude(cablePortRegion, length = floorThickness + 4mm, symmetric = true)
  |> translate(
       x = cablePortX - (cablePortWidth / 2),
       y = cablePortY - (cablePortDepth / 2),
       z = shellFloorZ + floorThickness / 2,
       global = true,
     )
leftCablePort = clone(rightCablePort)
  |> translate(x = -cablePortX * 2, global = true)

// ---- tether entry -----------------------------------------------------------

// There is no battery, so a single umbilical brings 24 V and CAN in from the
// bench. It enters the back of the shell as low as the wall allows, for the two
// reasons the keel used to be the place for it: down here the tether's pull
// acts near the hip axes rather than at the top of a 106 mm lever, and it
// arrives beside the power-entry block instead of crossing the electronics
// stack above it.
//
// What has changed is that the block is no longer loaded from underneath. The
// keel was open at the bottom and the power-entry stack dropped in between the
// legs; this floor is closed, so everything inside goes in through the cover.
// That is one access route for a 100 mm-deep box, which is worth remembering
// when the capacitor bank is finally sized.
//
// Strain relief is a cable tie, not a clamp or a threaded insert. The tie goes
// out through one narrow slot, around the tether inside the shell, and back in
// through the other, so a pull on the cable is carried in shear by 2.4 mm of
// wall and never reaches the terminal. That also keeps every cut on this part
// rectangular, which is the only blind pocket shape the engine will take out of
// this shell -- see the cable ports above and the note in NOTES.md.
tetherPortWidth = tetherCableDiameter + 4mm
tetherPortHeight = tetherCableDiameter
// Two millimetres above the cavity's inside floor, so the slot opens into the
// cavity with the shell floor left intact below it.
tetherPortZ = cavityBottomZ + 2mm + tetherPortHeight / 2
// Negative Y is the rear: the foot's front pressure pads sit at y = +51 and its
// rear pads at y = -40, and the leading leg in walk_pose_check.kcl swings to +Y.
tetherWallY = -(torsoShellDepth / 2 - (shellWall / 2))
tieSlotWidth = 3mm
tieSlotHeight = 8mm
tieSlotX = tetherPortWidth / 2 + 5mm

tetherPortSketch = sketch(on = XZ) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 16mm, var 0mm])
  edge2 = line(start = [var 16mm, var 0mm], end = [var 16mm, var 12mm])
  edge3 = line(start = [var 16mm, var 12mm], end = [var 0mm, var 12mm])
  edge4 = line(start = [var 0mm, var 12mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == tetherPortWidth
  verticalDistance([edge2.start, edge2.end]) == tetherPortHeight
}
tetherPortRegion = region(
  segments = [
    tetherPortSketch.edge1,
    tetherPortSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
tetherPort = extrude(tetherPortRegion, length = shellWall + 4mm, symmetric = true)
  |> translate(
       x = -tetherPortWidth / 2,
       y = tetherWallY,
       z = tetherPortZ - (tetherPortHeight / 2),
       global = true,
     )

tieSlotSketch = sketch(on = XZ) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 3mm, var 0mm])
  edge2 = line(start = [var 3mm, var 0mm], end = [var 3mm, var 8mm])
  edge3 = line(start = [var 3mm, var 8mm], end = [var 0mm, var 8mm])
  edge4 = line(start = [var 0mm, var 8mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == tieSlotWidth
  verticalDistance([edge2.start, edge2.end]) == tieSlotHeight
}
tieSlotRegion = region(
  segments = [
    tieSlotSketch.edge1,
    tieSlotSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
rightTieSlot = extrude(tieSlotRegion, length = shellWall + 4mm, symmetric = true)
  |> translate(
       x = tieSlotX - (tieSlotWidth / 2),
       y = tetherWallY,
       z = tetherPortZ - (tieSlotHeight / 2),
       global = true,
     )
leftTieSlot = clone(rightTieSlot)
  |> translate(x = -tieSlotX * 2, global = true)

// Slots first, into the simple box, then the cavity. Taking them out of the
// already-hollowed shell is the ordering the engine rejects, and it is the same
// ordering the keel needed when the tether entered through that instead.
shellSlotted = subtract(
  shellBlank,
  tools = [
    rightCablePort,
    leftCablePort,
    tetherPort,
    rightTieSlot,
    leftTieSlot
  ],
)
shellRaw = subtract(shellSlotted, tools = [shellCavity])

// ---- hip pitch joints -------------------------------------------------------

// No quarter turn: the clevis is used exactly as joint.kcl draws it, axis across
// the robot, because a hip pitch joint is what it was drawn for. The saddle
// lands in the shell floor and, being 51 mm across against a shell half-width of
// 59, it runs out through the lower side wall as well -- so this hip's load
// enters the closed section through two faces rather than one.
rightHipPitchJoint = statorClevis()
  |> translate(x = hipCenterX, z = hipPitchZ, global = true)

// The left hip is the right one reflected, not a second copy of it. The rear
// cheek carries a relief cut on the actuator's connector flat, and a plain copy
// would leave that relief facing the same way at both hips -- outboard on one
// leg, inboard on the other, so that actuator's leads would have to leave
// towards the centre line and turn back on themselves. Reflecting keeps both
// reliefs on the rear of their own actuator, which is the same thing as
// installing the left actuator spun 180 degrees about its own axis.
//
// `mirror3d` copies rather than transforms -- it leaves the original standing in
// the scene -- so the source is hidden afterwards. See docs/KCL_GOTCHAS.md.
leftHipPitchSource = clone(rightHipPitchJoint)
leftHipPitchJoint = mirror3d(leftHipPitchSource, across = YZ)
hide(leftHipPitchSource)

hide(shellOuterSketch)
hide(shellInnerSketch)
hide(tetherPortSketch)
hide(tieSlotSketch)
hide(cablePortSketch)

// ---- cover bosses and lid ---------------------------------------------------

// Both are the shared design from torso_shell.kcl, drawn to this box. The
// bosses belong to the pelvis print and are given its appearance below; the lid
// is a print of its own.
bossX = coverBossInset(torsoInnerWidth)
bossY = coverBossInset(torsoInnerDepth)

bossRearRight = coverBoss(bossX, y = bossY, topZ = shellTopZ)
bossRearLeft = coverBoss(-bossX, y = bossY, topZ = shellTopZ)
bossFrontRight = coverBoss(bossX, y = -bossY, topZ = shellTopZ)
bossFrontLeft = coverBoss(-bossX, y = -bossY, topZ = shellTopZ)

// The shell, the four bosses and both hip clevises are one printed part -- seven
// bodies, where the eight-motor pelvis needed twelve. They are left as
// interpenetrating bodies rather than unioned for the reason NOTES.md already
// records: the engine refuses to union hollow boxes that meet at right angles,
// and the hip saddles are exactly that case. Every overlap here is several
// millimetres of real solid, so a slicer that merges coincident shells prints
// them as the single part they are. Verify that before printing.
//
// Exported on its own, alongside `torsoAssembly`, because it is one print and
// the cover is another: tools/export.py writes a STEP per printed piece, and
// rendering a part with nothing behind it is how a pocket or a hole in it is
// confirmed open (CLAUDE.md, docs/KCL_GOTCHAS.md).
export pelvisShell = appearance(
  [
    shellRaw,
    bossRearRight,
    bossRearLeft,
    bossFrontRight,
    bossFrontLeft,
    rightHipPitchJoint,
    leftHipPitchJoint
  ],
  color = printedOrange,
  roughness = 72,
  metalness = 3,
)

export torsoCover = appearance(
  torsoLid(torsoShellWidth, lidDepth = torsoShellDepth, topZ = shellTopZ),
  color = printedDark,
  roughness = 72,
  metalness = 3,
)

export torsoAssembly = [pelvisShell, torsoCover]
