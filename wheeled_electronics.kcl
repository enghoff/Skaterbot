// What actually goes in the wheeled robot's torso
//
// payload_envelopes.kcl reserves volumes and says nothing about what fills them.
// That was fine while the torso was 106 mm tall and the reservations rattled
// around inside it. It stopped being fine when the torso was cut to 65 mm and
// sized FROM those volumes, because at that point the question is no longer "is
// there room" but "does this particular set of boards go in in this particular
// order", and a box you cannot see into does not answer it.
//
// So this file draws the four items as recognisable hardware and stands each one
// inside its own reserved envelope. The envelope is still the requirement; the
// board is what has to fit in it, and the two are drawn together so a render
// shows both at once.
//
// WHERE THE SIZES COME FROM. The boards are docs/BOM.md's, the envelopes are
// payload_envelopes.kcl's, and neither is invented here:
//
// * CONTROLLER CARRIER, in a 76 x 46 x 12 envelope. A carrier holding a WeAct
// STM32G474CEU6 core board -- 36.3 x 28.1 mm, which BOM.md picked over a
// NUCLEO-G474RE precisely because the NUCLEO does not fit this volume -- plus
// two MCP2542FD-class CAN-FD transceivers and the harness header.
// * SBC, in an 85 x 58 x 16 envelope, and the only optional item here. Drawn as
// a single-board computer of that footprint: board, SoC, a connector bank on
// one long edge and a 40-pin header on the other.
// * POWER ENTRY, in a 38 x 62 x 30 envelope. Low-ESR bulk capacitor bank, an
// automotive blade fuse and holder, and the tether's terminal. THE BANK HAS
// NOT BEEN SIZED -- BOM.md has it as a red line pending a measured bus
// excursion -- so the four cans drawn here are a plausible bank filling the
// reservation, not a specification. They are the softest geometry in the file.
// * IMU, in a 22 x 22 x 6 envelope. A BNO085 Nano breakout, about 11 x 10 x 6,
// which BOM.md again chose over the larger Adafruit board on volume grounds.
//
// WHY THEY SIT WHERE THEY SIT. The two hip clevises are rooted in the shell
// floor and stand 9 mm proud of it across |x| = 26 to 60, so the floor is only
// clear in the 51.5 mm between them. The IMU is the one item narrow enough to
// use that, and it wants to be there anyway: it is the stiffest place in the
// pelvis and it sits directly between the two hip axes. Everything else starts
// at the saddle tops. Power entry and the controller share that band side by
// side, which is what set the shell's 125 mm width, and the SBC goes over both
// because at 85 mm it is wider than the gap either of them leaves.
//
// Coordinates are torso-local: the origin is the torso centre.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"
import wheeledTorsoShellWidth, wheeledTorsoInteriorFloorZ, wheeledHipSaddleRise from "wheeled_parameters.kcl"

interiorHalfWidth = (wheeledTorsoShellWidth - (shellWall * 2)) / 2
floorZ = wheeledTorsoInteriorFloorZ
saddleTopZ = floorZ + wheeledHipSaddleRise

// How much air each item leaves against the side wall it is pushed up to. The
// pair in the lower band needs 114 of the 120.2 mm available, so 2 mm at each
// wall leaves 2.2 mm between them.
wallClearance = 2mm
bandGap = 2mm

// ---- the reserved volumes, which are the requirement ------------------------


powerWidth = 38mm
powerDepth = 62mm
powerHeight = 30mm
controllerWidth = 76mm
controllerDepth = 46mm
controllerHeight = 12mm
sbcWidth = 85mm
sbcDepth = 58mm
sbcHeight = 16mm
imuWidth = 22mm
imuDepth = 22mm
imuHeight = 6mm

powerX = interiorHalfWidth - wallClearance - (powerWidth / 2)
controllerX = -interiorHalfWidth + wallClearance + controllerWidth / 2
lowerBandZ = saddleTopZ
upperBandZ = lowerBandZ + powerHeight + bandGap

// ---- two shapes, used for everything ----------------------------------------

// A rectangular solid on its centre in x and y, sitting on atZ. Every board,
// connector and terminal here is one of these.
fn slab(@width, depth, height, atX, atY, atZ) {
  slabSketch = sketch(on = XY) {
    edge1 = line(start = [var 0mm, var 0mm], end = [var 20mm, var 0mm])
    edge2 = line(start = [var 20mm, var 0mm], end = [var 20mm, var 20mm])
    edge3 = line(start = [var 20mm, var 20mm], end = [var 0mm, var 20mm])
    edge4 = line(start = [var 0mm, var 20mm], end = [var 0mm, var 0mm])
    coincident([edge1.start, ORIGIN])
    coincident([edge1.end, edge2.start])
    coincident([edge2.end, edge3.start])
    coincident([edge3.end, edge4.start])
    coincident([edge4.end, edge1.start])
    horizontal(edge1)
    vertical(edge2)
    horizontal(edge3)
    vertical(edge4)
    horizontalDistance([edge1.start, edge1.end]) == width
    verticalDistance([edge2.start, edge2.end]) == depth
  }
  slabRegion = region(segments = [slabSketch.edge1, slabSketch.edge2], intersectionIndex = -1, direction = CCW)
  slabBody = extrude(slabRegion, length = height)
    |> translate(
         x = atX - (width / 2),
         y = atY - (depth / 2),
         z = atZ,
         global = true,
       )
  hide(slabSketch)
  return slabBody
}

// An electrolytic can, standing on atZ. The capacitor bank is the only round
// thing in the torso.
fn can(@canDiameter, height, atX, atY, atZ) {
  canSketch = sketch(on = XY) {
    canCircle = circle(start = [var 8mm, var 0mm], center = [var 0mm, var 0mm])
    coincident([canCircle.center, ORIGIN])
    horizontal([canCircle.center, canCircle.start])
    diameter(canCircle) == canDiameter
  }
  canRegion = region(segments = [canSketch.canCircle])
  canBody = extrude(canRegion, length = height)
    |> translate(
         x = atX,
         y = atY,
         z = atZ,
         global = true,
       )
  hide(canSketch)
  return canBody
}

pcbThickness = 1.6mm

// ---- power entry: bank, fuse and terminal -----------------------------------


powerBoard = slab(
  powerWidth,
  depth = powerDepth,
  height = pcbThickness,
  atX = powerX,
  atY = 0mm,
  atZ = lowerBandZ,
)
capacitorDiameter = 16mm
capacitorHeight = 25mm
capacitorZ = lowerBandZ + pcbThickness
cap1 = can(
  capacitorDiameter,
  height = capacitorHeight,
  atX = powerX - 9mm,
  atY = -11mm,
  atZ = capacitorZ,
)
cap2 = can(
  capacitorDiameter,
  height = capacitorHeight,
  atX = powerX + 9mm,
  atY = -11mm,
  atZ = capacitorZ,
)
cap3 = can(
  capacitorDiameter,
  height = capacitorHeight,
  atX = powerX - 9mm,
  atY = 11mm,
  atZ = capacitorZ,
)
cap4 = can(
  capacitorDiameter,
  height = capacitorHeight,
  atX = powerX + 9mm,
  atY = 11mm,
  atZ = capacitorZ,
)

// The tether lands here, which is why it is on the rear face: the slot in the
// shell's back wall is 20 mm below and a little inboard of this terminal.
tetherTerminal = slab(
  30mm,
  depth = 10mm,
  height = 12mm,
  atX = powerX,
  atY = -25mm,
  atZ = capacitorZ,
)
bladeFuse = slab(
  20mm,
  depth = 10mm,
  height = 14mm,
  atX = powerX,
  atY = 25mm,
  atZ = capacitorZ,
)

// ---- controller carrier -----------------------------------------------------


controllerBoard = slab(
  controllerWidth,
  depth = controllerDepth,
  height = pcbThickness,
  atX = controllerX,
  atY = 0mm,
  atZ = lowerBandZ,
)
// The WeAct core board, on headers above the carrier.
mcuModule = slab(
  36.3mm,
  depth = 28.1mm,
  height = 6mm,
  atX = controllerX - 12mm,
  atY = 3mm,
  atZ = lowerBandZ + pcbThickness,
)
transceiver1 = slab(
  6mm,
  depth = 4mm,
  height = 1.5mm,
  atX = controllerX + 20mm,
  atY = 8mm,
  atZ = lowerBandZ + pcbThickness,
)
transceiver2 = slab(
  6mm,
  depth = 4mm,
  height = 1.5mm,
  atX = controllerX + 20mm,
  atY = 0mm,
  atZ = lowerBandZ + pcbThickness,
)
// Where the six actuator harnesses land, facing the rear wall and its two cable
// ports through the floor.
harnessHeader = slab(
  46mm,
  depth = 6mm,
  height = 8mm,
  atX = controllerX + 8mm,
  atY = -19mm,
  atZ = lowerBandZ + pcbThickness,
)

// ---- SBC --------------------------------------------------------------------


sbcBoard = slab(
  sbcWidth,
  depth = sbcDepth,
  height = pcbThickness,
  atX = 0mm,
  atY = 0mm,
  atZ = upperBandZ,
)
sbcSoc = slab(
  15mm,
  depth = 15mm,
  height = 2mm,
  atX = -6mm,
  atY = 0mm,
  atZ = upperBandZ + pcbThickness,
)
// The connector bank stands 13.5 mm off the board and is what makes the whole
// item 16 mm rather than 3. It faces forward, away from the tether.
sbcPortsLeft = slab(
  18mm,
  depth = 16mm,
  height = 13.5mm,
  atX = -22mm,
  atY = 21mm,
  atZ = upperBandZ + pcbThickness,
)
sbcPortsRight = slab(
  18mm,
  depth = 16mm,
  height = 13.5mm,
  atX = 8mm,
  atY = 21mm,
  atZ = upperBandZ + pcbThickness,
)
sbcHeader = slab(
  51mm,
  depth = 5mm,
  height = 8.5mm,
  atX = 0mm,
  atY = -26mm,
  atZ = upperBandZ + pcbThickness,
)

// ---- IMU, in the clear floor between the two hip saddles --------------------


imuBoard = slab(
  11mm,
  depth = 10mm,
  height = pcbThickness,
  atX = 0mm,
  atY = 0mm,
  atZ = floorZ,
)
imuChip = slab(
  4mm,
  depth = 4mm,
  height = 1.2mm,
  atX = 0mm,
  atY = 0mm,
  atZ = floorZ + pcbThickness,
)

// ---- the reservations, drawn round what fills them --------------------------


powerEnvelopeRaw = slab(
  powerWidth,
  depth = powerDepth,
  height = powerHeight,
  atX = powerX,
  atY = 0mm,
  atZ = lowerBandZ,
)
controllerEnvelopeRaw = slab(
  controllerWidth,
  depth = controllerDepth,
  height = controllerHeight,
  atX = controllerX,
  atY = 0mm,
  atZ = lowerBandZ,
)
sbcEnvelopeRaw = slab(
  sbcWidth,
  depth = sbcDepth,
  height = sbcHeight,
  atX = 0mm,
  atY = 0mm,
  atZ = upperBandZ,
)
imuEnvelopeRaw = slab(
  imuWidth,
  depth = imuDepth,
  height = imuHeight,
  atX = 0mm,
  atY = 0mm,
  atZ = floorZ,
)

// ---- appearance -------------------------------------------------------------

// Four finishes, and one flat list at the end. Flat matters: a scene places the
// payload with `translate`, and translate takes solids or a list of solids but
// not a list of lists, so grouping these by colour into sub-lists would make the
// export unplaceable.
pcbGreen = "#1c6b42"
componentBlack = "#20232a"
canSilver = "#8c939c"
terminalBlue = "#2f5fb4"

fn asPcb(@body) {
  return appearance(
    body,
    color = pcbGreen,
    roughness = 60,
    metalness = 5,
  )
}
fn asComponent(@body) {
  return appearance(
    body,
    color = componentBlack,
    roughness = 50,
    metalness = 10,
  )
}
fn asCan(@body) {
  return appearance(
    body,
    color = canSilver,
    roughness = 30,
    metalness = 70,
  )
}
fn asTerminal(@body) {
  return appearance(
    body,
    color = terminalBlue,
    roughness = 55,
    metalness = 5,
  )
}

// Faint on purpose. The board is the thing to look at; the envelope is only
// there to show how much of the reservation it actually uses.
powerEnvelope = appearance(
  powerEnvelopeRaw,
  color = "#7246a8",
  opacity = 22,
  roughness = 55,
  metalness = 0,
)
controllerEnvelope = appearance(
  controllerEnvelopeRaw,
  color = "#2f8a6d",
  opacity = 22,
  roughness = 50,
  metalness = 0,
)
sbcEnvelope = appearance(
  sbcEnvelopeRaw,
  color = "#3f6fac",
  opacity = 22,
  roughness = 50,
  metalness = 0,
)
imuEnvelope = appearance(
  imuEnvelopeRaw,
  color = "#e0c24c",
  opacity = 30,
  roughness = 42,
  metalness = 0,
)

// The hardware on its own, for a scene that wants to see nothing but the boards.
export torsoElectronics = [
  asPcb(powerBoard),
  asCan(cap1),
  asCan(cap2),
  asCan(cap3),
  asCan(cap4),
  asTerminal(tetherTerminal),
  asTerminal(bladeFuse),
  asPcb(controllerBoard),
  asComponent(mcuModule),
  asComponent(transceiver1),
  asComponent(transceiver2),
  asComponent(harnessHeader),
  asPcb(sbcBoard),
  asComponent(sbcSoc),
  asComponent(sbcPortsLeft),
  asComponent(sbcPortsRight),
  asComponent(sbcHeader),
  asPcb(imuBoard),
  asComponent(imuChip)
]

// The reservations on their own, which are what nothing may be designed through.
export torsoReservations = [
  powerEnvelope,
  controllerEnvelope,
  sbcEnvelope,
  imuEnvelope
]

// Both together, and what the assemblies place. Written out rather than built
// from the two lists above for the flatness reason at the top of this section.
export torsoPayload = [
  asPcb(powerBoard),
  asCan(cap1),
  asCan(cap2),
  asCan(cap3),
  asCan(cap4),
  asTerminal(tetherTerminal),
  asTerminal(bladeFuse),
  asPcb(controllerBoard),
  asComponent(mcuModule),
  asComponent(transceiver1),
  asComponent(transceiver2),
  asComponent(harnessHeader),
  asPcb(sbcBoard),
  asComponent(sbcSoc),
  asComponent(sbcPortsLeft),
  asComponent(sbcPortsRight),
  asComponent(sbcHeader),
  asPcb(imuBoard),
  asComponent(imuChip),
  powerEnvelope,
  controllerEnvelope,
  sbcEnvelope,
  imuEnvelope
]
