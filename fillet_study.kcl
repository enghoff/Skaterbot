// Study: a fillet in the rotor arm / bridge corner
//
// Not part of the build and not imported by anything. Two copies of rotorHub()
// stand side by side along the joint axis -- on the left as it is drawn today,
// on the right with a 4 mm fillet in the re-entrant corner -- so the change can
// be looked at rather than argued about.
//
// WHERE THE CORNER IS
// The arm runs x 18.95 to 24.95 and z -32 to 0. The bridge runs z -32 to -24
// and reaches back to x -15. So the two meet along a sharp internal corner at
// x = 18.95, z = -24, and that corner is the peak-stress point for the load the
// limb below puts through the offset: about 11 MPa nominal in the arm, which a
// sharp re-entrant angle multiplies by roughly 2.5.
//
// HOW THE FILLET IS DRAWN
// As a profile with an arc in it, not as a fillet operation and not as a block
// with a cylinder taken out of it. The block-minus-cylinder version is the
// obvious construction and the engine rejects it: the cutter ends up tangent to
// two faces of the block, which is exactly the case NOTES.md records as
// "cannot handle this 3D subtraction yet". Three segments and one extrude have
// no boolean in them at all.
//
// The fillet is as wide as the arm, not the bridge: the arm is shellInnerDepth
// deep and the bridge is the full shellDepth, so there is a second re-entrant
// step where the arm's sides meet the bridge. That one is not modelled here.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions and the shared drawing functions, reached through lib/main.kcl
import * from "lib/main.kcl"

// r/t = 0.67 against the 6 mm arm, which is the usual guidance for a printed
// re-entrant corner. Bigger buys little; smaller stops removing the peak.
filletRadius = 4mm
armWidth = shellDepth - (shellWall * 2)
bridgeTopZ = -rotorEndHeight + bridgeHeight
studyOffset = 34mm

// Local origin sits on the corner itself. The profile runs along the bridge
// top, round the concave face, and back down the arm face.
filletSketch = sketch(on = XZ) {
  bridgeLeg = line(start = [var 0mm, var 0mm], end = [var -4mm, var 0mm])
  concaveFace = arc(start = [var -4mm, var 0mm], end = [var 0mm, var 4mm], center = [var -4mm, var 4mm])
  armLeg = line(start = [var 0mm, var 4mm], end = [var 0mm, var 0mm])
  coincident([bridgeLeg.start, ORIGIN])
  coincident([bridgeLeg.end, concaveFace.start])
  coincident([concaveFace.end, armLeg.start])
  coincident([armLeg.end, bridgeLeg.start])
  horizontal(bridgeLeg)
  vertical(armLeg)
  horizontalDistance([bridgeLeg.end, bridgeLeg.start]) == filletRadius
  verticalDistance([armLeg.end, armLeg.start]) == filletRadius
}
filletRegion = region(
  segments = [
    filletSketch.bridgeLeg,
    filletSketch.concaveFace
  ],
  intersectionIndex = -1,
  direction = CCW,
)
filletWedge = extrude(filletRegion, length = armWidth, symmetric = true)
  |> translate(x = rotorHubInnerX, z = bridgeTopZ, global = true)

// ---- the two copies --------------------------------------------------------


sharpRotorEnd = rotorHub()
  |> translate(x = -studyOffset, global = true)

filletedRotorEnd = rotorHub()
  |> translate(x = studyOffset, global = true)

filletedCorner = filletWedge
  |> translate(x = studyOffset, global = true)

hide(filletSketch)

sharpBody = appearance(
  sharpRotorEnd,
  color = printedOrange,
  roughness = 72,
  metalness = 3,
)
filletedBody = appearance(
  filletedRotorEnd,
  color = printedOrange,
  roughness = 72,
  metalness = 3,
)
// Called out in a different colour so the added material reads at a glance.
// Left as a separate body rather than unioned -- the two share a face, which is
// the same interpenetrating-bodies fallback the foot and the pelvis already use.
addedMaterial = appearance(
  filletedCorner,
  color = sensorBlue,
  roughness = 60,
  metalness = 6,
)

export filletStudy = [sharpBody, filletedBody, addedMaterial]
