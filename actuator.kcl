// DM-J3507-2EC envelope
// Overall envelope taken from the authoritative sources rather than estimated:
// the vendor STEP (dm_3507_3d-241021.STEP) and user manual V1.0, 2024-11-19.
//
// The part is Ø46.0 mm x 37.9 mm overall and NOTHING protrudes beyond that.
// The earlier proxy added an output flange, an output boss and a rear pilot
// outside the 37.9 mm body, which made the envelope 48.9 mm long and put the
// output interface about 7 mm too far out. The real output flange, its register
// and the stator mounting pattern are all recessed into the two end faces, so
// the envelope is a plain cylinder and the interface is described by the
// exported bolt-circle parameters instead of by guessed geometry.
//
// +Z is the output face; the connectors are on the -Z rear face, seated against
// a flat chord on the housing. That flat, the two housing bolt patterns and the
// rear tapped holes are all keep-outs and interfaces this proxy deliberately
// does not model -- see the actuatorRear* and actuatorConnectorFlat*
// parameters, which carry them as numbers instead.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"

motorBodySketch = sketch(on = XY) {
  bodyCircle = circle(start = [var 23mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([bodyCircle.center, ORIGIN])
  horizontal([bodyCircle.center, bodyCircle.start])
  diameter(bodyCircle) == actuatorDiameter
}
motorBodyRegion = region(segments = [motorBodySketch.bodyCircle])
motorBodyRaw = extrude(motorBodyRegion, length = actuatorDepth, symmetric = true)

hide(motorBodySketch)

motorBody = appearance(
  motorBodyRaw,
  color = motorGrey,
  metalness = 62,
  roughness = 34,
)

export actuatorAssembly = [motorBody]
