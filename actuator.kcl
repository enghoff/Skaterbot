// DM-J3507-2EC simplified envelope
// Replaceable actuator proxy using the requested 46 mm by 37.9 mm authoritative envelope.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"

motorBodySketch = sketch(on = XY) {
  bodyCircle = circle(start = [var 23mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([bodyCircle.center, ORIGIN])
  horizontal([bodyCircle.center, bodyCircle.start])
  diameter(bodyCircle) == actuatorDiameter
}
motorBodyRegion = region(segments = [motorBodySketch.bodyCircle])
motorBodyRaw = extrude(motorBodyRegion, length = actuatorDepth, symmetric = true)

outputFlangeSketch = sketch(on = XY) {
  flangeCircle = circle(start = [var 17mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([flangeCircle.center, ORIGIN])
  horizontal([
    flangeCircle.center,
    flangeCircle.start
  ])
  diameter(flangeCircle) == 34mm
}
outputFlangeRegion = region(segments = [outputFlangeSketch.flangeCircle])
outputFlangeRaw = extrude(outputFlangeRegion, length = 3mm, symmetric = true)
  |> translate(z = actuatorDepth / 2 + 1.5mm, global = true)

outputBossSketch = sketch(on = XY) {
  bossCircle = circle(start = [var 6mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([bossCircle.center, ORIGIN])
  horizontal([bossCircle.center, bossCircle.start])
  diameter(bossCircle) == 12mm
}
outputBossRegion = region(segments = [outputBossSketch.bossCircle])
outputBossRaw = extrude(outputBossRegion, length = 5mm, symmetric = true)
  |> translate(z = actuatorDepth / 2 + 5.5mm, global = true)

rearPilotSketch = sketch(on = XY) {
  pilotCircle = circle(start = [var 8mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([pilotCircle.center, ORIGIN])
  horizontal([pilotCircle.center, pilotCircle.start])
  diameter(pilotCircle) == 16mm
}
rearPilotRegion = region(segments = [rearPilotSketch.pilotCircle])
rearPilotRaw = extrude(rearPilotRegion, length = 3mm, symmetric = true)
  |> translate(z = -actuatorDepth / 2 - 1.5mm, global = true)

hide(motorBodySketch)
hide(outputFlangeSketch)
hide(outputBossSketch)
hide(rearPilotSketch)

motorBody = appearance(
  motorBodyRaw,
  color = motorGrey,
  metalness = 62,
  roughness = 34,
)
outputFlange = appearance(
  outputFlangeRaw,
  color = motorFlange,
  metalness = 78,
  roughness = 24,
)
outputBoss = appearance(
  outputBossRaw,
  color = bearingSteel,
  metalness = 86,
  roughness = 18,
)
rearPilot = appearance(
  rearPilotRaw,
  color = printedDark,
  metalness = 38,
  roughness = 40,
)

export actuatorAssembly = [
  motorBody,
  outputFlange,
  outputBoss,
  rearPilot
]
