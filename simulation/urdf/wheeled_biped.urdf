  <!-- PROVISIONAL TRAVEL. No swept clearance check has ever been run on hip pitch; the knee's stop is the only joint limit this project has established, and that one is measured. -->
  <joint name="hip_pitch_right" type="revolute">
    <parent link="base_link"/>
    <child link="thigh_right"/>
    <origin xyz="0 -0.048 -0.0685" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.04719755" upper="1.04719755" effort="3.0" velocity="48.2"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- The commissioning hard stop, read out of cad/poses.py. It is MEASURED now rather than inherited: the thigh's knee clevis puts a saddle back in the plane the shin sweeps, and the two touch at 103.0 deg. tools/gate_f.py holds the 1 mm. -->
  <joint name="knee_right" type="revolute">
    <parent link="thigh_right"/>
    <child link="shin_right"/>
    <origin xyz="0 -0.0027 -0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.74532925" effort="3.0" velocity="48.2"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- Direct drive; no reduction beyond the actuator's own 7:1. -->
  <joint name="wheel_drive_right" type="continuous">
    <parent link="shin_right"/>
    <child link="wheel_right"/>
    <origin xyz="0 0 -0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="3.0" velocity="48.2"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- PROVISIONAL TRAVEL. No swept clearance check has ever been run on hip pitch; the knee's stop is the only joint limit this project has established, and that one is measured. -->
  <joint name="hip_pitch_left" type="revolute">
    <parent link="base_link"/>
    <child link="thigh_left"/>
    <origin xyz="0 0.048 -0.0685" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.04719755" upper="1.04719755" effort="3.0" velocity="48.2"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- The commissioning hard stop, read out of cad/poses.py. It is MEASURED now rather than inherited: the thigh's knee clevis puts a saddle back in the plane the shin sweeps, and the two touch at 103.0 deg. tools/gate_f.py holds the 1 mm. -->
  <joint name="knee_left" type="revolute">
    <parent link="thigh_left"/>
    <child link="shin_left"/>
    <origin xyz="0 0.0027 -0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.74532925" effort="3.0" velocity="48.2"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- Direct drive; no reduction beyond the actuator's own 7:1. -->
  <joint name="wheel_drive_left" type="continuous">
    <parent link="shin_left"/>
    <child link="wheel_left"/>
    <origin xyz="0 0 -0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="3.0" velocity="48.2"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

</robot>
