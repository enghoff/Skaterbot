  <!-- PROVISIONAL TRAVEL. No swept clearance check has ever been run on hip pitch; the knee's 110 deg stop is the only joint limit this project has established. -->
  <joint name="hip_pitch_right" type="revolute">
    <parent link="base_link"/>
    <child link="thigh_right"/>
    <origin xyz="0 -0.048 -0.0565" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.04719755" upper="1.04719755" effort="3.0" velocity="20.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- 110 deg is the commissioning hard stop, knee_limit_check.kcl. -->
  <joint name="knee_right" type="revolute">
    <parent link="thigh_right"/>
    <child link="shin_right"/>
    <origin xyz="0 0 -0.105" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.91986218" effort="3.0" velocity="20.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <!-- Direct drive; no reduction beyond the actuator's own 7:1. -->
  <joint name="wheel_drive_right" type="continuous">
    <parent link="shin_right"/>
    <child link="wheel_right"/>
