// The dimensions and the shared drawing functions, and the only file in lib/
// that anything above it can see
//
// KCL lets a file import from its own directory or from a subdirectory, but a
// subdirectory may only be entered through its main.kcl, and a path may not
// climb with "..". So this file re-exports the modules beside it, and a scene
// or a part one level up reaches all of them with a single import.
//
// WHAT IS IN HERE, AND WHY THE PARTS ARE NOT
// Importing a module RUNS it, and any solid the module built at its top level
// joins the scene of whatever imported it, whether that scene asked for it or
// not. Everything in this directory is therefore geometry-free: numbers, and
// functions that draw only when they are called. Nothing here can put a body
// in a scene by being imported.
//
// The part modules -- thigh, torso, wheel and the rest -- are the opposite:
// each builds its bodies at the top level, so importing one is how a scene
// gets it. They stay in the project root beside the scenes, because a scene
// has to be able to import them one at a time to control what it contains.
// Behind this facade they would all arrive at once, and main.kcl would be
// carrying the walking robot's feet.
//
// It holds no dimensions of its own. Every name below is defined, and its
// provenance recorded, in the module it is re-exported from.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions. parameters.kcl is the single source for the robot as a whole;
// wheeled_parameters.kcl derives the six-motor robot's stack heights from it.
export import * from "parameters.kcl"
export import * from "wheeled_parameters.kcl"

// The joint interface every limb is built around: the discs, the saddle
// heights, and the bearing carrier and journal that go with them.
export import * from "joint.kcl"
export import * from "hardware.kcl"

// Shapes that are drawn to order, from a length, a span or a box size.
export import * from "limb.kcl"
export import * from "hip_carrier.kcl"
export import * from "torso_shell.kcl"
export import * from "skate_wheel.kcl"
