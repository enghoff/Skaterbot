// Flat-plate limb
//
// One parametric limb, used for the thigh and the shin. It is a plate lying in
// a single plane: a Ø52 disc bolted flat to one actuator's rear cover, a Ø36
// disc bolted to the next actuator's output, and a channel waist between them.
// There is no clevis, no saddle and no closed shell, and nothing reaches around
// an actuator any more.
//
// Local frame: the limb axis is Z, both joint axes are X, and the two joint
// centres sit at z = +/- limbLength/2. The plate lies on the +X side with both
// actuators inboard of it. That works because the knee actuator is turned round
// -- see the note in parameters.kcl -- so the upper joint presents its output
// face and the lower joint presents its rear cover on the same side.
//
// A limb for the other hand is this one spun 180 degrees about Z, which is a
// true mirror here because every feature is symmetric fore and aft. thigh.kcl
// and shin.kcl each export both hands; and because the two leg segments are the
// same 105 mm, the right thigh and the left shin are the same print, as are the
// right shin and the left thigh. Two distinct limb parts, as before.
//
// The waist is a plain plate. It carried two stiffening flanges on its outboard
// face for a while; they came off on 30 August 2026 once the numbers were run,
// because they bought stiffness and almost no strength, and none at all at the
// section that decides whether a limb breaks. The reasoning is kept beside the
// waist below and in NOTES.md.
//
// What is left is a single flat profile, 6 mm thick from one end to the other,
// which is both the cheapest thing to print and the strongest way to print it:
// laid flat, every fibre runs along the limb and no load crosses a layer line.
//
// The waist is not symmetric about the limb centre. Each end runs as far into
// its disc as that disc's bolt pattern allows, and the two patterns are not the
// same distance out, so the two ends are not either.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"
import outputDisc, statorPlate from "joint.kcl"

export fn limbAssembly(@limbLength) {
  jointZ = limbLength / 2

  // The waist reaches into both discs so the three bodies merge, but it cannot
  // reach the same distance at both ends. At the rotor end it stops where
  // parameters.kcl puts it, one counterbore clear of the Ø24 output circle. At
  // the stator end the Ø41 rear bolts are the constraint, and a waist symmetric
  // about the limb centre overshot them: its corner landed 0.7 mm from the two
  // bolt centres nearest the waist and filled 46 % of each hole, leaving a
  // 1.2 mm crescent no screw could pass. It now stops a cap head short of them,
  // which costs nothing structurally -- the plate is still 38 mm wide there, so
  // the section never narrows -- and leaves 8 mm of engagement into the disc.
  waistUpperZ = limbWaistUpperZ
  waistLowerZ = -(jointZ - actuatorRearBoltOffset - m3CapHeadStandoff)

  waistSketch = sketch(on = XY) {
    edge1 = line(start = [var 0mm, var 0mm], end = [var 6mm, var 0mm])
    edge2 = line(start = [var 6mm, var 0mm], end = [var 6mm, var 40mm])
    edge3 = line(start = [var 6mm, var 40mm], end = [var 0mm, var 40mm])
    edge4 = line(start = [var 0mm, var 40mm], end = [var 0mm, var 0mm])
    coincident([edge1.start, ORIGIN])
    coincident([edge1.end, edge2.start])
    coincident([edge2.end, edge3.start])
    coincident([edge3.end, edge4.start])
    coincident([edge4.end, edge1.start])
    horizontal(edge1)
    vertical(edge2)
    horizontal(edge3)
    vertical(edge4)
    horizontalDistance([edge1.start, edge1.end]) == limbPlateThickness
    verticalDistance([edge2.start, edge2.end]) == limbWaistDepth
  }
  waistRegion = region(segments = [waistSketch.edge1, waistSketch.edge2], intersectionIndex = -1, direction = CCW)
  waistPlate = extrude(waistRegion, length = waistUpperZ - waistLowerZ)
    |> translate(
         x = rotorHubInnerX,
         y = -(limbWaistDepth / 2),
         z = waistLowerZ,
         global = true,
       )

  // The flanges are gone, and the waist is a plain plate again.
  //
  // They were never fitted against a known weakness; they were asked for, and
  // the analysis that should have come first came after. A flange adds material
  // outboard but moves the outermost fibre out with it, so the two effects very
  // nearly cancel for strength while compounding for stiffness. At the 4.2 mm
  // reach they ended at, they were worth 2.5x on the section's lateral second
  // moment -- 540 mm^4 to 1 326 -- and 15 per cent on its section modulus, which
  // is the number that decides whether the limb snaps: 180 mm^3 to 207.
  //
  // And they were absent from the section that governs. The weakest printed
  // thing on the robot is the short run of bare plate just under the thigh's
  // hip-pitch hub, and the flange stopped a cheek radius short of it -- the hip
  // carrier's front cheek is in the way, which is the same obstacle that stopped
  // a central flange being added there. So the limb's breaking load was the same
  // with the flanges as without: 23.7 N sideways at the foot across the layers,
  // 59.2 N in the print plane.
  //
  // What does buy strength, in order: print orientation, worth 2.5x for nothing,
  // and a thicker plate, worth 1.78x going 6 mm to 8 and lifting the bare run
  // too, which no flange can. See NOTES.md, August 30 2026.
  //
  // Removing them also leaves the limb a single flat profile 6 mm thick from end
  // to end, which is what lets it be printed flat with no support at all.

  // Where the waist runs into the hub disc, the plate has to neck down from
  // 40 mm to the Ø36 disc, and the step between them is where the limb hands
  // its bending into the joint -- the peak-stress point on the part. These two
  // gussets carry the width up past that step as a taper, running from the
  // waist's top corner to the point where the taper goes tangent to the disc's
  // rim, so the section narrows gradually instead of in a shoulder.
  //
  // While the waist was 30 mm the gusset was a small fillet tangent to both the
  // plate's side and the disc. That construction has no solution once the waist
  // is wider than the disc: a line 20 mm off the axis never touches a circle of
  // radius 18, so the blend became a straight taper instead.
  //
  // The inner edge is a chord between two points on the disc, so it is buried --
  // a chord of a circle stays inside it -- and the visible outline is the disc's
  // own arc. The taper clears both output counterbore rows: it is outboard of
  // y = 15.7 everywhere it passes the pair on the horizontal diameter, whose
  // heads reach y = 15.
  discRadius = rotorHubDiameter / 2
  gussetDrop = jointZ - waistUpperZ
  gussetHalfWidth = limbWaistDepth / 2
  // Unitless, so sqrt and pow have something they can work on.
  rN = discRadius / 1mm
  dN = gussetDrop / 1mm
  hN = gussetHalfWidth / 1mm
  gussetSpanSq = pow(hN, exp = 2) + pow(dN, exp = 2)
  gussetTangentLen = sqrt(gussetSpanSq - pow(rN, exp = 2))
  // Where the disc's rim crosses the waist's top edge, and where the taper from
  // the waist's corner goes tangent to that rim.
  gussetArchY = sqrt(pow(rN, exp = 2) - pow(dN, exp = 2)) * 1mm
  gussetTangentY = (pow(rN, exp = 2) * hN + rN * gussetTangentLen * dN) / gussetSpanSq * 1mm
  gussetTangentZ = jointZ + (rN * gussetTangentLen * hN - (pow(rN, exp = 2) * dN)) / gussetSpanSq * 1mm

  gussetSketch = sketch(on = YZ) {
    rootEdge = line(start = [var 0mm, var 0mm], end = [var 8.69mm, var 0mm])
    outerEdge = line(start = [var 8.69mm, var 0mm], end = [var 6.53mm, var 16.35mm])
    innerEdge = line(start = [var 6.53mm, var 16.35mm], end = [var 0mm, var 0mm])
    coincident([rootEdge.start, ORIGIN])
    coincident([rootEdge.end, outerEdge.start])
    coincident([outerEdge.end, innerEdge.start])
    coincident([innerEdge.end, rootEdge.start])
    horizontal(rootEdge)
    horizontalDistance([rootEdge.start, rootEdge.end]) == gussetHalfWidth - gussetArchY
    horizontalDistance([innerEdge.end, innerEdge.start]) == gussetTangentY - gussetArchY
    verticalDistance([innerEdge.end, innerEdge.start]) == gussetTangentZ - waistUpperZ
  }
  gussetRegion = region(
    segments = [
      gussetSketch.rootEdge,
      gussetSketch.outerEdge
    ],
    direction = CCW,
  )
  gussetFront = extrude(gussetRegion, length = limbPlateThickness, symmetric = true)
    |> translate(
         x = rotorHubInnerX + limbPlateThickness / 2,
         y = gussetArchY,
         z = waistUpperZ,
         global = true,
       )
  gussetRear = mirror3d(gussetFront, across = XZ)

  upperDisc = outputDisc()
    |> translate(z = jointZ, global = true)
  // The stator plate is drawn behind an actuator whose output faces +X. This
  // limb's lower actuator is turned round, so the plate is spun to the near side
  // to land on the rear cover that now faces +X with everything else.
  lowerPlate = statorPlate()
    |> rotate(axis = [0, 0, 1], angle = 180deg, global = true)
    |> translate(z = -jointZ, global = true)

  hide(waistSketch)
  hide(gussetSketch)

  // Five interpenetrating bodies rather than one solid. The waist plate occupies
  // exactly the same band in X as both discs, which is the union the engine
  // refuses -- see docs/KCL_GOTCHAS.md -- and the flanges share a face with the
  // waist for the same reason. Every overlap is millimetres of real material, so
  // a slicer that merges coincident shells prints this as the single plate it
  // is. Verify that before printing.
  return appearance(
    [
      waistPlate,
      gussetFront,
      gussetRear,
      upperDisc,
      lowerPlate
    ],
    color = printedOrange,
    roughness = 70,
    metalness = 3,
  )
}
