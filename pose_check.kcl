// Wheeled biped kinematic pose check
//
// Crouched stance with one wheel lifted, for sagittal clearance and joint-chain
// validation. The hip and knee angles are exactly the ones the walking pose
// check used, so the clearance figures stay comparable across the two
// architectures; what has gone is the ankle at the bottom of the leg and hip
// roll at the top.
//
// There are two joints in this leg above the wheel, not four, and no foot angle
// to carry -- and with hip roll deleted the torso hangs straight off the hip
// pitch axes, so this scene is also the first check that its floor clears a
// thigh swung 35 degrees forward. The wheel is
// a solid of revolution bolted to its motor's output, so how far it has turned
// changes nothing anyone can measure off this scene -- it is placed, not
// rotated.
//
// The standing leg's axle lands at exactly 40 mm, which is the wheel's own
// radius, so the left wheel is tangent to the floor and the drop is real rather
// than drawn. The lifted leg clears the ground by about 27 mm.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions and the shared drawing functions, reached through lib/main.kcl
import * from "lib/main.kcl"
import actuatorAssembly from "actuator.kcl"
import thighRight, thighLeft from "thigh.kcl"
import shinRight, shinLeft from "shin.kcl"
import wheelRight, wheelLeft from "wheel.kcl"
import torsoAssembly from "torso.kcl"
import torsoPayload from "wheeled_electronics.kcl"

leftHipAngle = -6deg
leftKneeAngle = 12deg
leftShinAngle = leftHipAngle - leftKneeAngle

rightHipAngle = 35deg
rightKneeAngle = 65deg
rightShinAngle = rightHipAngle - rightKneeAngle

leftLegVerticalReach = upperLegLength * cos(leftHipAngle) + lowerLegLength * cos(leftShinAngle)
crouchDrop = upperLegLength + lowerLegLength - leftLegVerticalReach
poseHipPitchZ = wheeledHipPitchAxisHeight - crouchDrop
poseTorsoCenterZ = wheeledTorsoCenterHeight - crouchDrop

leftKneeY = upperLegLength * sin(leftHipAngle)
leftKneeZ = poseHipPitchZ - (upperLegLength * cos(leftHipAngle))
leftWheelY = leftKneeY + lowerLegLength * sin(leftShinAngle)
leftWheelZ = leftKneeZ - (lowerLegLength * cos(leftShinAngle))
leftThighCenterY = leftKneeY / 2
leftThighCenterZ = (poseHipPitchZ + leftKneeZ) / 2
leftShinCenterY = (leftKneeY + leftWheelY) / 2
leftShinCenterZ = (leftKneeZ + leftWheelZ) / 2

rightKneeY = upperLegLength * sin(rightHipAngle)
rightKneeZ = poseHipPitchZ - (upperLegLength * cos(rightHipAngle))
rightWheelY = rightKneeY + lowerLegLength * sin(rightShinAngle)
rightWheelZ = rightKneeZ - (lowerLegLength * cos(rightShinAngle))
rightThighCenterY = rightKneeY / 2
rightThighCenterZ = (poseHipPitchZ + rightKneeZ) / 2
rightShinCenterY = (rightKneeY + rightWheelY) / 2
rightShinCenterZ = (rightKneeZ + rightWheelZ) / 2

actuatorCopy2 = clone(actuatorAssembly)
actuatorCopy3 = clone(actuatorAssembly)
actuatorCopy4 = clone(actuatorAssembly)
actuatorCopy5 = clone(actuatorAssembly)
actuatorCopy6 = clone(actuatorAssembly)

// ---- actuators -------------------------------------------------------------


leftHipPitchMotor = actuatorAssembly
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(x = -hipCenterX, z = poseHipPitchZ, global = true)
rightHipPitchMotor = actuatorCopy2
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(x = hipCenterX, z = poseHipPitchZ, global = true)

leftKneeMotor = actuatorCopy3
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(
       x = -hipCenterX,
       y = leftKneeY,
       z = leftKneeZ,
       global = true,
     )
rightKneeMotor = actuatorCopy4
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(
       x = hipCenterX,
       y = rightKneeY,
       z = rightKneeZ,
       global = true,
     )

leftWheelMotor = actuatorCopy5
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(
       x = -hipCenterX,
       y = leftWheelY,
       z = leftWheelZ,
       global = true,
     )
rightWheelMotor = actuatorCopy6
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(
       x = hipCenterX,
       y = rightWheelY,
       z = rightWheelZ,
       global = true,
     )

// ---- joint hardware, carried by the stationary side of each joint ----------


leftHipPitchHardware = jointHardware()
  |> rotate(axis = [0, 0, 1], angle = 180deg, global = true)
  |> translate(x = -hipCenterX, z = poseHipPitchZ, global = true)
rightHipPitchHardware = jointHardware()
  |> translate(x = hipCenterX, z = poseHipPitchZ, global = true)

// ---- printed structure -----------------------------------------------------


leftThigh = thighLeft
  |> rotate(axis = [1, 0, 0], angle = leftHipAngle, global = true)
  |> translate(
       x = -hipCenterX,
       y = leftThighCenterY,
       z = leftThighCenterZ,
       global = true,
     )
rightThigh = thighRight
  |> rotate(axis = [1, 0, 0], angle = rightHipAngle, global = true)
  |> translate(
       x = hipCenterX,
       y = rightThighCenterY,
       z = rightThighCenterZ,
       global = true,
     )

leftShin = shinLeft
  |> rotate(axis = [1, 0, 0], angle = leftShinAngle, global = true)
  |> translate(
       x = -hipCenterX,
       y = leftShinCenterY,
       z = leftShinCenterZ,
       global = true,
     )
rightShin = shinRight
  |> rotate(axis = [1, 0, 0], angle = rightShinAngle, global = true)
  |> translate(
       x = hipCenterX,
       y = rightShinCenterY,
       z = rightShinCenterZ,
       global = true,
     )

leftWheel = wheelLeft
  |> translate(
       x = -hipCenterX,
       y = leftWheelY,
       z = leftWheelZ,
       global = true,
     )
rightWheel = wheelRight
  |> translate(
       x = hipCenterX,
       y = rightWheelY,
       z = rightWheelZ,
       global = true,
     )

bodyFrame = torsoAssembly
  |> translate(z = poseTorsoCenterZ, global = true)
reservedPayload = torsoPayload
  |> translate(z = poseTorsoCenterZ, global = true)

export poseCheckAssembly = [
  bodyFrame,
  reservedPayload,
  leftHipPitchMotor,
  rightHipPitchMotor,
  leftKneeMotor,
  rightKneeMotor,
  leftWheelMotor,
  rightWheelMotor,
  leftHipPitchHardware,
  rightHipPitchHardware,
  leftThigh,
  rightThigh,
  leftShin,
  rightShin,
  leftWheel,
  rightWheel
]
