// The parts of the torso that are one design at two sizes
//
// Two pelvises are built over this file. The wheeled robot's, in torso.kcl, is
// 125 x 68 x 65 and hangs its hip PITCH actuators straight off its floor; the
// walking robot's, in walking_torso.kcl, is 118 x 68 x 106 and hangs hip ROLL
// actuators off a floor 51 mm higher, with a keel reaching down between them.
//
// They used to share a section, so this file could hold finished bodies at fixed
// heights. They no longer do -- the wheeled box is 7 mm wider and 41 mm shorter
// -- so what is shared is a DESIGN and not a part: the same lid on the same four
// bosses with the same lip and the same four screws, drawn to whatever box it is
// closing. That makes them functions, exactly as hip_carrier.kcl is one carrier
// at two axis spans and limb.kcl is one limb at two lengths.
//
// Nothing here stands at the top level, so importing from this file puts no
// geometry into a scene that did not ask for it.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"

// The one section dimension the two pelvises still agree on. Depth is set by
// the actuators' fore-and-aft envelope, which neither robot changed; width is
// each pelvis' own business, because the wheeled one grew to fit two boards
// side by side.
export torsoShellDepth = 68mm

// Provisional. A cable has to leave each hip actuator and get inside, and this
// slot clears both the saddle and the cheeks on either pelvis. Its exact
// position waits on the mated-plug measurement that Phase 6 is blocked on.
export cablePortWidth = 14mm
export cablePortDepth = 10mm
export cablePortX = 40mm
export cablePortY = -28mm

bossSize = 8mm
bossHeight = 12mm
bossHoleDiameter = 2.5mm
coverLipHeight = 2.4mm

// Where the four cover screws land, as an inset from the cavity's own corners.
// The boss and the hole through the lid have to agree on this, and they are
// built by two different functions, so it is computed once here.
export fn coverBossInset(@innerSpan) {
  return innerSpan / 2 - (bossSize / 2)
}

// One tapped boss standing down from the shell's top face. Four of these carry
// the lid, and they are part of whichever pelvis calls for them rather than
// parts in their own right.
export fn coverBoss(@x, y, topZ) {
  bossCenterZ = topZ - (bossHeight / 2)

  bossSketch = sketch(on = XY) {
    edge1 = line(start = [var 0mm, var 0mm], end = [var 8mm, var 0mm])
    edge2 = line(start = [var 8mm, var 0mm], end = [var 8mm, var 8mm])
    edge3 = line(start = [var 8mm, var 8mm], end = [var 0mm, var 8mm])
    edge4 = line(start = [var 0mm, var 8mm], end = [var 0mm, var 0mm])
    coincident([edge1.start, ORIGIN])
    coincident([edge1.end, edge2.start])
    coincident([edge2.end, edge3.start])
    coincident([edge3.end, edge4.start])
    coincident([edge4.end, edge1.start])
    horizontal(edge1)
    vertical(edge2)
    horizontal(edge3)
    vertical(edge4)
    horizontalDistance([edge1.start, edge1.end]) == bossSize
    verticalDistance([edge2.start, edge2.end]) == bossSize
  }
  bossRegion = region(segments = [bossSketch.edge1, bossSketch.edge2], intersectionIndex = -1, direction = CCW)

  bossHoleSketch = sketch(on = XY) {
    holeCircle = circle(start = [var 1.25mm, var 0mm], center = [var 0mm, var 0mm])
    coincident([holeCircle.center, ORIGIN])
    horizontal([holeCircle.center, holeCircle.start])
    diameter(holeCircle) == bossHoleDiameter
  }
  bossHoleRegion = region(segments = [bossHoleSketch.holeCircle])

  bossBlank = extrude(bossRegion, length = bossHeight, symmetric = true)
    |> translate(
         x = x - (bossSize / 2),
         y = y - (bossSize / 2),
         z = bossCenterZ,
         global = true,
       )
  bossHole = extrude(bossHoleRegion, length = bossHeight + 2mm, symmetric = true)
    |> translate(
         x = x,
         y = y,
         z = bossCenterZ,
         global = true,
       )

  hide(bossSketch)
  hide(bossHoleSketch)

  return subtract(bossBlank, tools = [bossHole])
}

// The removable lid: a plate the size of the box's outside, a lip that drops
// into the cavity to locate it, and four clearance holes onto the bosses.
export fn torsoLid(@lidWidth, lidDepth, topZ) {
  innerWidth = lidWidth - (shellWall * 2)
  innerDepth = lidDepth - (shellWall * 2)
  coverCenterZ = topZ + torsoCoverThickness / 2
  coverLipWidth = innerWidth - 0.4mm
  coverLipDepth = innerDepth - 0.4mm
  coverLipCenterZ = topZ - (coverLipHeight / 2)
  screwX = coverBossInset(innerWidth)
  screwY = coverBossInset(innerDepth)

  coverOuterSketch = sketch(on = XY) {
    edge1 = line(start = [var 0mm, var 0mm], end = [var 118mm, var 0mm])
    edge2 = line(start = [var 118mm, var 0mm], end = [var 118mm, var 68mm])
    edge3 = line(start = [var 118mm, var 68mm], end = [var 0mm, var 68mm])
    edge4 = line(start = [var 0mm, var 68mm], end = [var 0mm, var 0mm])
    coincident([edge1.start, ORIGIN])
    coincident([edge1.end, edge2.start])
    coincident([edge2.end, edge3.start])
    coincident([edge3.end, edge4.start])
    coincident([edge4.end, edge1.start])
    horizontal(edge1)
    vertical(edge2)
    horizontal(edge3)
    vertical(edge4)
    horizontalDistance([edge1.start, edge1.end]) == lidWidth
    verticalDistance([edge2.start, edge2.end]) == lidDepth
  }
  coverOuterRegion = region(
    segments = [
      coverOuterSketch.edge1,
      coverOuterSketch.edge2
    ],
    intersectionIndex = -1,
    direction = CCW,
  )
  coverPlate = extrude(coverOuterRegion, length = torsoCoverThickness, symmetric = true)
    |> translate(
         x = -lidWidth / 2,
         y = -lidDepth / 2,
         z = coverCenterZ,
         global = true,
       )

  coverLipSketch = sketch(on = XY) {
    edge1 = line(start = [var 0mm, var 0mm], end = [var 112mm, var 0mm])
    edge2 = line(start = [var 112mm, var 0mm], end = [var 112mm, var 62mm])
    edge3 = line(start = [var 112mm, var 62mm], end = [var 0mm, var 62mm])
    edge4 = line(start = [var 0mm, var 62mm], end = [var 0mm, var 0mm])
    coincident([edge1.start, ORIGIN])
    coincident([edge1.end, edge2.start])
    coincident([edge2.end, edge3.start])
    coincident([edge3.end, edge4.start])
    coincident([edge4.end, edge1.start])
    horizontal(edge1)
    vertical(edge2)
    horizontal(edge3)
    vertical(edge4)
    horizontalDistance([edge1.start, edge1.end]) == coverLipWidth
    verticalDistance([edge2.start, edge2.end]) == coverLipDepth
  }
  coverLipRegion = region(
    segments = [
      coverLipSketch.edge1,
      coverLipSketch.edge2
    ],
    intersectionIndex = -1,
    direction = CCW,
  )
  coverLip = extrude(coverLipRegion, length = coverLipHeight, symmetric = true)
    |> translate(
         x = -coverLipWidth / 2,
         y = -coverLipDepth / 2,
         z = coverLipCenterZ,
         global = true,
       )

  coverScrewSketch = sketch(on = XY) {
    screwCircle = circle(start = [var 1.7mm, var 0mm], center = [var 0mm, var 0mm])
    coincident([screwCircle.center, ORIGIN])
    horizontal([screwCircle.center, screwCircle.start])
    diameter(screwCircle) == m3Clearance
  }
  // Long enough to clear the lip as well as the plate: a screw hole that stopped
  // inside the lip would be a blind cylindrical pocket, which the engine refuses.
  coverScrewRegion = region(segments = [coverScrewSketch.screwCircle])
  coverScrewLength = torsoCoverThickness + coverLipHeight + 2mm
  coverScrewZ = topZ - coverLipHeight + (coverLipHeight + torsoCoverThickness) / 2
  coverScrew1 = extrude(coverScrewRegion, length = coverScrewLength, symmetric = true)
    |> translate(
         x = screwX,
         y = screwY,
         z = coverScrewZ,
         global = true,
       )
  coverScrew2 = clone(coverScrew1)
    |> translate(x = -screwX * 2, global = true)
  coverScrew3 = clone(coverScrew1)
    |> translate(y = -screwY * 2, global = true)
  coverScrew4 = clone(coverScrew2)
    |> translate(y = -screwY * 2, global = true)

  hide(coverOuterSketch)
  hide(coverLipSketch)
  hide(coverScrewSketch)

  coverBlank = union([coverPlate, coverLip])
  return subtract(
    coverBlank,
    tools = [
      coverScrew1,
      coverScrew2,
      coverScrew3,
      coverScrew4
    ],
  )
}
