// Foot
//
// The nine overlapping rails are gone. The foot is now a shallow open-topped
// tray -- a 2.4 mm floor with a continuous perimeter wall around it -- so a
// landing load runs into a closed perimeter instead of into the roots of four
// thin rails. NOTES.md listed that as priority weakness 4; this is the fix.
//
// The tray is open at the top on purpose, and it is a printing decision rather
// than a structural one. The foot prints sole-face-down on the bed, which is the
// orientation that puts the layer lines across the landing load instead of along
// it. In that orientation an open top needs no support anywhere, and a closed
// one would have to bridge 60 mm. The floor and the perimeter wall are what
// carry the load; a top skin would add mass at the neutral axis and buy little.
//
// Two transverse ribs sit directly under the ankle spreader and a longitudinal
// rib ties heel to toe through it, so the ankle's load reaches all four walls
// rather than only the floor beneath it.
//
// The sole stays a separate replaceable part, and the four sensor seats keep
// their positions.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions and the shared drawing functions, reached through lib/main.kcl
import * from "lib/main.kcl"

soleCenterZ = -ankleAxisHeight + soleThickness / 2

trayBottomZ = -ankleAxisHeight + soleThickness
trayHeight = footTrayHeight
trayTopZ = trayBottomZ + trayHeight
trayCenterZ = (trayBottomZ + trayTopZ) / 2
trayFloorThickness = shellWall
trayInnerWidth = footWidth - (shellWall * 2)
trayInnerLength = footLength - (shellWall * 2)
trayCavityBottomZ = trayBottomZ + trayFloorThickness
trayCavityHeight = trayTopZ + 2mm - trayCavityBottomZ

ribThickness = shellWall
ribHeight = trayTopZ - trayCavityBottomZ
ribCenterZ = (trayCavityBottomZ + trayTopZ) / 2

spreaderWidth = 52mm
// The spreader used to be an 8 mm slab hung under the rotor bridge, and the
// bridge sat on top of the tray. That left 5.6 mm of trapped air between the
// slab's underside and the tray floor: the ankle's whole load reached the floor
// only through the two transverse ribs the slab straddled. The bridge now nests
// inside the tray, so the spreader runs the full depth from the sole up to it
// and the void is gone -- its underside is the tray's own bottom face.
//
// What sets its top is what passes over it. The shin's stator plate reaches
// statorPlateDiameter / 2 below the ankle axis, and because that plate is a
// disc centred on the axis its silhouette does not change as the ankle moves --
// it sweeps exactly itself, at every joint angle. The old top landed at exactly
// that radius and grazed the plate; it now stops one clearance short, which is
// the room the shin has to turn in.
spreaderTopZ = -(statorPlateDiameter / 2) - jointBodyClearance
spreaderThickness = spreaderTopZ - trayBottomZ
spreaderCenterZ = (trayBottomZ + spreaderTopZ) / 2
// The two transverse ribs land just inside the spreader's edges. That was the
// spreader's only load path down when it was a slab floating above the floor;
// it now reaches the floor on its own, and the ribs tie its footprint out to
// the side walls instead.
transverseRibY = shellDepth / 2 - (ribThickness / 2)

// ---- replaceable sole -------------------------------------------------------


soleSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 65mm, var 0mm])
  edge2 = line(start = [var 65mm, var 0mm], end = [var 65mm, var 115mm])
  edge3 = line(start = [var 65mm, var 115mm], end = [var 0mm, var 115mm])
  edge4 = line(start = [var 0mm, var 115mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == footWidth
  verticalDistance([edge2.start, edge2.end]) == footLength
}
soleRegion = region(segments = [soleSketch.edge1, soleSketch.edge2], intersectionIndex = -1, direction = CCW)
soleRaw = extrude(soleRegion, length = soleThickness, symmetric = true)
  |> translate(
       x = -footWidth / 2,
       y = footCenterY - (footLength / 2),
       z = soleCenterZ,
       global = true,
     )

// ---- tray -------------------------------------------------------------------


trayOuterRegion = region(segments = [soleSketch.edge1, soleSketch.edge2], intersectionIndex = -1, direction = CCW)
trayBlank = extrude(trayOuterRegion, length = trayHeight, symmetric = true)
  |> translate(
       x = -footWidth / 2,
       y = footCenterY - (footLength / 2),
       z = trayCenterZ,
       global = true,
     )

trayInnerSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 60mm, var 0mm])
  edge2 = line(start = [var 60mm, var 0mm], end = [var 60mm, var 110mm])
  edge3 = line(start = [var 60mm, var 110mm], end = [var 0mm, var 110mm])
  edge4 = line(start = [var 0mm, var 110mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == trayInnerWidth
  verticalDistance([edge2.start, edge2.end]) == trayInnerLength
}
trayInnerRegion = region(
  segments = [
    trayInnerSketch.edge1,
    trayInnerSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
trayCavity = extrude(trayInnerRegion, length = trayCavityHeight, symmetric = true)
  |> translate(
       x = -trayInnerWidth / 2,
       y = footCenterY - (trayInnerLength / 2),
       z = trayCavityBottomZ + trayCavityHeight / 2,
       global = true,
     )
trayRaw = subtract(trayBlank, tools = [trayCavity])

// ---- ribs -------------------------------------------------------------------


transverseRibSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 60mm, var 0mm])
  edge2 = line(start = [var 60mm, var 0mm], end = [var 60mm, var 2mm])
  edge3 = line(start = [var 60mm, var 2mm], end = [var 0mm, var 2mm])
  edge4 = line(start = [var 0mm, var 2mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == trayInnerWidth
  verticalDistance([edge2.start, edge2.end]) == ribThickness
}
transverseRibRegion = region(
  segments = [
    transverseRibSketch.edge1,
    transverseRibSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
rearRibRaw = extrude(transverseRibRegion, length = ribHeight, symmetric = true)
  |> translate(
       x = -trayInnerWidth / 2,
       y = -transverseRibY - (ribThickness / 2),
       z = ribCenterZ,
       global = true,
     )
frontRibRaw = clone(rearRibRaw)
  |> translate(y = transverseRibY * 2, global = true)

longRibSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 2mm, var 0mm])
  edge2 = line(start = [var 2mm, var 0mm], end = [var 2mm, var 110mm])
  edge3 = line(start = [var 2mm, var 110mm], end = [var 0mm, var 110mm])
  edge4 = line(start = [var 0mm, var 110mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == ribThickness
  verticalDistance([edge2.start, edge2.end]) == trayInnerLength
}
longRibRegion = region(
  segments = [
    longRibSketch.edge1,
    longRibSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
spineRibRaw = extrude(longRibRegion, length = ribHeight, symmetric = true)
  |> translate(
       x = -ribThickness / 2,
       y = footCenterY - (trayInnerLength / 2),
       z = ribCenterZ,
       global = true,
     )

// ---- ankle attachment -------------------------------------------------------

// The foot is the rotor of the ankle joint: it bolts straight to the actuator's
// output circle through the shared hub in joint.kcl. The bridge that hub ends
// in now sits down inside the tray rather than on top of it, and the spreader
// is the solid pad it lands on, straddling the two transverse ribs and carrying
// the load the rest of the way down to the sole.
spreaderSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 52mm, var 0mm])
  edge2 = line(start = [var 52mm, var 0mm], end = [var 52mm, var 30mm])
  edge3 = line(start = [var 52mm, var 30mm], end = [var 0mm, var 30mm])
  edge4 = line(start = [var 0mm, var 30mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == spreaderWidth
  verticalDistance([edge2.start, edge2.end]) == shellDepth
}
spreaderRegion = region(
  segments = [
    spreaderSketch.edge1,
    spreaderSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
spreaderRaw = extrude(spreaderRegion, length = spreaderThickness, symmetric = true)
  |> translate(
       x = -spreaderWidth / 2,
       y = -shellDepth / 2,
       z = spreaderCenterZ,
       global = true,
     )

ankleHubRaw = rotorHub()

// ---- sensor seats -----------------------------------------------------------


sensorSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 10mm, var 0mm])
  edge2 = line(start = [var 10mm, var 0mm], end = [var 10mm, var 10mm])
  edge3 = line(start = [var 10mm, var 10mm], end = [var 0mm, var 10mm])
  edge4 = line(start = [var 0mm, var 10mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == 10mm
  verticalDistance([edge2.start, edge2.end]) == 10mm
}
sensorRegion = region(segments = [sensorSketch.edge1, sensorSketch.edge2], intersectionIndex = -1, direction = CCW)
rearLeftSensorRaw = extrude(sensorRegion, length = 1mm)
  |> translate(
       x = -28mm,
       y = -40mm,
       z = -ankleAxisHeight + soleThickness,
       global = true,
     )
rearRightSensorRaw = clone(rearLeftSensorRaw)
  |> translate(x = 46mm, global = true)
frontLeftSensorRaw = clone(rearLeftSensorRaw)
  |> translate(y = 91mm, global = true)
frontRightSensorRaw = clone(rearRightSensorRaw)
  |> translate(y = 91mm, global = true)

hide(soleSketch)
hide(trayInnerSketch)
hide(transverseRibSketch)
hide(longRibSketch)
hide(spreaderSketch)
hide(sensorSketch)

sole = appearance(
  soleRaw,
  color = soleBlack,
  roughness = 92,
  metalness = 0,
)

// Tray, ribs, spreader and ankle hub are one printed part, left as
// interpenetrating bodies for the reason NOTES.md records: the engine refuses
// some of these unions. Every overlap is millimetres of real solid, so a slicer
// that merges coincident shells prints them as the single part they are.
footShell = appearance(
  [
    trayRaw,
    rearRibRaw,
    frontRibRaw,
    spineRibRaw,
    spreaderRaw,
    ankleHubRaw
  ],
  color = printedOrange,
  roughness = 76,
  metalness = 2,
)
sensorPads = appearance(
  [
    rearLeftSensorRaw,
    rearRightSensorRaw,
    frontLeftSensorRaw,
    frontRightSensorRaw
  ],
  color = sensorBlue,
  roughness = 45,
  metalness = 8,
)

// The two hands. The robot is mirror-symmetric about its midline, so this part
// exists left and right. `mirror3d` copies rather than transforms -- it leaves
// the original standing in the scene -- so the source is hidden afterwards.
// See docs/KCL_GOTCHAS.md.
export footRight = [sole, footShell, sensorPads]

footMirrorSource = clone(footRight)
export footLeft = mirror3d(footMirrorSource, across = YZ)
hide(footMirrorSource)
