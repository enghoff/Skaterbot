// Deepest legal squat, both wheels on the ground
//
// The scene the wheeled robot needs and the walking one never did. A walking
// biped crouches with its feet flat and its shins clear of everything; a wheeled
// one folds a Ø80 disc up towards its own thigh, and the disc is 40 mm of
// radius in every direction rather than a flat plate that sweeps its own
// silhouette.
//
// WHAT SETS THE POSE. Two things, and between them they leave no freedom. The
// knee cannot pass its 110 degree commissioning stop -- the same angle
// knee_limit_check.kcl is drawn at -- and both axles have to stay at 40 mm or
// the wheels are not on the floor. Making the squat symmetric, so that each axle
// sits directly under its own hip rather than thrown fore or aft, then fixes the
// hip at half the knee angle: 55 degrees of hip, 110 of knee, 55 of shin the
// other way.
//
// WHAT IT COSTS. The leg reaches 120.4 mm vertically instead of 210, so the
// torso drops 89.6 mm and the robot stands 249 mm rather than 339. The knees
// come 86 mm forward of the hip axis, which is the number to watch: it is where
// the payload envelope and the knee actuators have to miss each other.
//
// The thigh clears the wheel comfortably at this angle -- the nearest point of
// the thigh line is a full leg segment from the axle -- so what this scene is
// really for is the knee actuator against the torso floor, and the wheel against
// the shin's own stator plate.
//
// The torso floor matters more here than it used to. With hip roll deleted the
// pelvis comes down 51 mm and reaches its full 125 mm width all the way to the
// hip pitch axes, so at 55 degrees of hip this is where a thigh and a full-width
// floor would meet if they were going to.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions and the shared drawing functions, reached through lib/main.kcl
import * from "lib/main.kcl"
import actuatorAssembly from "actuator.kcl"
import thighRight, thighLeft from "thigh.kcl"
import shinRight, shinLeft from "shin.kcl"
import wheelRight, wheelLeft from "wheel.kcl"
import torsoAssembly from "torso.kcl"
import torsoPayload from "wheeled_electronics.kcl"

// The commissioning stop, from knee_limit_check.kcl.
squatKneeAngle = 110deg
squatHipAngle = squatKneeAngle / 2
squatShinAngle = squatHipAngle - squatKneeAngle

legVerticalReach = upperLegLength * cos(squatHipAngle) + lowerLegLength * cos(squatShinAngle)
squatDrop = upperLegLength + lowerLegLength - legVerticalReach
squatHipPitchZ = wheeledHipPitchAxisHeight - squatDrop
squatTorsoCenterZ = wheeledTorsoCenterHeight - squatDrop

kneeY = upperLegLength * sin(squatHipAngle)
kneeZ = squatHipPitchZ - (upperLegLength * cos(squatHipAngle))
wheelY = kneeY + lowerLegLength * sin(squatShinAngle)
wheelZ = kneeZ - (lowerLegLength * cos(squatShinAngle))
thighCenterY = kneeY / 2
thighCenterZ = (squatHipPitchZ + kneeZ) / 2
shinCenterY = (kneeY + wheelY) / 2
shinCenterZ = (kneeZ + wheelZ) / 2

actuatorCopy2 = clone(actuatorAssembly)
actuatorCopy3 = clone(actuatorAssembly)
actuatorCopy4 = clone(actuatorAssembly)
actuatorCopy5 = clone(actuatorAssembly)
actuatorCopy6 = clone(actuatorAssembly)

// ---- actuators -------------------------------------------------------------


leftHipPitchMotor = actuatorAssembly
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(x = -hipCenterX, z = squatHipPitchZ, global = true)
rightHipPitchMotor = actuatorCopy2
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(x = hipCenterX, z = squatHipPitchZ, global = true)

leftKneeMotor = actuatorCopy3
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(
       x = -hipCenterX,
       y = kneeY,
       z = kneeZ,
       global = true,
     )
rightKneeMotor = actuatorCopy4
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(
       x = hipCenterX,
       y = kneeY,
       z = kneeZ,
       global = true,
     )

leftWheelMotor = actuatorCopy5
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(
       x = -hipCenterX,
       y = wheelY,
       z = wheelZ,
       global = true,
     )
rightWheelMotor = actuatorCopy6
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(
       x = hipCenterX,
       y = wheelY,
       z = wheelZ,
       global = true,
     )

// ---- joint hardware, carried by the stationary side of each joint ----------


leftHipPitchHardware = jointHardware()
  |> rotate(axis = [0, 0, 1], angle = 180deg, global = true)
  |> translate(x = -hipCenterX, z = squatHipPitchZ, global = true)
rightHipPitchHardware = jointHardware()
  |> translate(x = hipCenterX, z = squatHipPitchZ, global = true)

// ---- printed structure -----------------------------------------------------


leftThigh = thighLeft
  |> rotate(axis = [1, 0, 0], angle = squatHipAngle, global = true)
  |> translate(
       x = -hipCenterX,
       y = thighCenterY,
       z = thighCenterZ,
       global = true,
     )
rightThigh = thighRight
  |> rotate(axis = [1, 0, 0], angle = squatHipAngle, global = true)
  |> translate(
       x = hipCenterX,
       y = thighCenterY,
       z = thighCenterZ,
       global = true,
     )

leftShin = shinLeft
  |> rotate(axis = [1, 0, 0], angle = squatShinAngle, global = true)
  |> translate(
       x = -hipCenterX,
       y = shinCenterY,
       z = shinCenterZ,
       global = true,
     )
rightShin = shinRight
  |> rotate(axis = [1, 0, 0], angle = squatShinAngle, global = true)
  |> translate(
       x = hipCenterX,
       y = shinCenterY,
       z = shinCenterZ,
       global = true,
     )

leftWheel = wheelLeft
  |> translate(
       x = -hipCenterX,
       y = wheelY,
       z = wheelZ,
       global = true,
     )
rightWheel = wheelRight
  |> translate(
       x = hipCenterX,
       y = wheelY,
       z = wheelZ,
       global = true,
     )

bodyFrame = torsoAssembly
  |> translate(z = squatTorsoCenterZ, global = true)
reservedPayload = torsoPayload
  |> translate(z = squatTorsoCenterZ, global = true)

export squatCheckAssembly = [
  bodyFrame,
  reservedPayload,
  leftHipPitchMotor,
  rightHipPitchMotor,
  leftKneeMotor,
  rightKneeMotor,
  leftWheelMotor,
  rightWheelMotor,
  leftHipPitchHardware,
  rightHipPitchHardware,
  leftThigh,
  rightThigh,
  leftShin,
  rightShin,
  leftWheel,
  rightWheel
]
