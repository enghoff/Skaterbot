// Compact torque-controlled biped skeleton
// Neutral 380 mm assembly with eight actuators, double-supported joints, carbon links, open feet, and torso packaging.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"
import actuatorAssembly from "actuator.kcl"
import pitchYokeAssembly from "pitch_yoke.kcl"
import thighAssembly from "thigh.kcl"
import shinAssembly from "shin.kcl"
import hipCarrierAssembly from "hip_carrier.kcl"
import footAssembly from "foot.kcl"
import torsoAssembly from "torso.kcl"
import payloadEnvelopes from "payload_envelopes.kcl"

thighCenterZ = (hipPitchAxisHeight + kneeAxisHeight) / 2
shinCenterZ = (kneeAxisHeight + ankleAxisHeight) / 2
hipCarrierCenterZ = (hipRollAxisHeight + hipPitchAxisHeight) / 2

actuatorCopy2 = clone(actuatorAssembly)
actuatorCopy3 = clone(actuatorAssembly)
actuatorCopy4 = clone(actuatorAssembly)
actuatorCopy5 = clone(actuatorAssembly)
actuatorCopy6 = clone(actuatorAssembly)
actuatorCopy7 = clone(actuatorAssembly)
actuatorCopy8 = clone(actuatorAssembly)

yokeCopy2 = clone(pitchYokeAssembly)
yokeCopy3 = clone(pitchYokeAssembly)
yokeCopy4 = clone(pitchYokeAssembly)
yokeCopy5 = clone(pitchYokeAssembly)
yokeCopy6 = clone(pitchYokeAssembly)
yokeCopy7 = clone(pitchYokeAssembly)
yokeCopy8 = clone(pitchYokeAssembly)

rightHipCarrierSource = clone(hipCarrierAssembly)
rightThighSource = clone(thighAssembly)
rightShinSource = clone(shinAssembly)
rightFootSource = clone(footAssembly)

leftHipRollMotor = actuatorAssembly
  |> rotate(axis = [1, 0, 0], angle = -90deg, global = true)
  |> translate(x = -hipCenterX, z = hipRollAxisHeight, global = true)
rightHipRollMotor = actuatorCopy2
  |> rotate(axis = [1, 0, 0], angle = -90deg, global = true)
  |> translate(x = hipCenterX, z = hipRollAxisHeight, global = true)

leftHipPitchMotor = actuatorCopy3
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(x = -hipCenterX, z = hipPitchAxisHeight, global = true)
leftKneeMotor = actuatorCopy4
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(x = -hipCenterX, z = kneeAxisHeight, global = true)
leftAnkleMotor = actuatorCopy5
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(x = -hipCenterX, z = ankleAxisHeight, global = true)

rightHipPitchMotor = actuatorCopy6
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(x = hipCenterX, z = hipPitchAxisHeight, global = true)
rightKneeMotor = actuatorCopy7
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(x = hipCenterX, z = kneeAxisHeight, global = true)
rightAnkleMotor = actuatorCopy8
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(x = hipCenterX, z = ankleAxisHeight, global = true)

leftHipRollYoke = pitchYokeAssembly
  |> rotate(axis = [0, 0, 1], angle = -90deg, global = true)
  |> translate(x = -hipCenterX, z = hipRollAxisHeight, global = true)
rightHipRollYoke = yokeCopy2
  |> rotate(axis = [0, 0, 1], angle = -90deg, global = true)
  |> translate(x = hipCenterX, z = hipRollAxisHeight, global = true)

leftHipPitchYoke = yokeCopy3
  |> translate(x = -hipCenterX, z = hipPitchAxisHeight, global = true)
leftKneeYoke = yokeCopy4
  |> translate(x = -hipCenterX, z = kneeAxisHeight, global = true)
leftAnkleYoke = yokeCopy5
  |> translate(x = -hipCenterX, z = ankleAxisHeight, global = true)

rightHipPitchYoke = yokeCopy6
  |> rotate(axis = [0, 0, 1], angle = 180deg, global = true)
  |> translate(x = hipCenterX, z = hipPitchAxisHeight, global = true)
rightKneeYoke = yokeCopy7
  |> rotate(axis = [0, 0, 1], angle = 180deg, global = true)
  |> translate(x = hipCenterX, z = kneeAxisHeight, global = true)
rightAnkleYoke = yokeCopy8
  |> rotate(axis = [0, 0, 1], angle = 180deg, global = true)
  |> translate(x = hipCenterX, z = ankleAxisHeight, global = true)

leftHipCarrier = hipCarrierAssembly
  |> translate(x = -hipCenterX, z = hipCarrierCenterZ, global = true)
rightHipCarrier = rightHipCarrierSource
  |> translate(x = hipCenterX, z = hipCarrierCenterZ, global = true)

leftThigh = thighAssembly
  |> translate(x = -hipCenterX, z = thighCenterZ, global = true)
rightThigh = rightThighSource
  |> translate(x = hipCenterX, z = thighCenterZ, global = true)

leftShin = shinAssembly
  |> translate(x = -hipCenterX, z = shinCenterZ, global = true)
rightShin = rightShinSource
  |> translate(x = hipCenterX, z = shinCenterZ, global = true)

leftFoot = footAssembly
  |> translate(x = -hipCenterX, z = ankleAxisHeight, global = true)
rightFoot = rightFootSource
  |> translate(x = hipCenterX, z = ankleAxisHeight, global = true)

bodyFrame = torsoAssembly
  |> translate(z = torsoCenterHeight, global = true)
reservedPayload = payloadEnvelopes
  |> translate(z = torsoCenterHeight, global = true)

export robotAssembly = [
  bodyFrame,
  reservedPayload,
  leftHipRollMotor,
  rightHipRollMotor,
  leftHipPitchMotor,
  rightHipPitchMotor,
  leftKneeMotor,
  rightKneeMotor,
  leftAnkleMotor,
  rightAnkleMotor,
  leftHipRollYoke,
  rightHipRollYoke,
  leftHipPitchYoke,
  rightHipPitchYoke,
  leftKneeYoke,
  rightKneeYoke,
  leftAnkleYoke,
  rightAnkleYoke,
  leftHipCarrier,
  rightHipCarrier,
  leftThigh,
  rightThigh,
  leftShin,
  rightShin,
  leftFoot,
  rightFoot
]
