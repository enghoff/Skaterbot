// Compact torque-controlled wheeled biped, stressed-shell build
//
// Neutral 339 mm assembly, and the model this branch is about. Each leg is hip
// pitch, knee pitch and a driven wheel -- six DM-J3507 actuators in total, on a
// robot that used to carry eight and stand 380 mm.
//
// WHAT WENT, AND WHY THE LEGS DID NOT MOVE
// Hip roll is gone: the actuator, its bearing set and journal, and the
// orthogonal printed carrier that used to hang the hip pitch joint off it. The
// hip pitch clevis is now part of the pelvis itself, rooted in a shell floor
// that has come down 51 mm to meet it, so nothing below the hip has changed at
// all. Thigh and shin are still 105 mm and the wheel axle is still 40 mm off
// the floor.
//
// The 41 mm the robot then lost off the top is the torso being cut from 106 mm
// to 65. Its floor could not move -- it is the seat the hip clevises are rooted
// in -- so the height came off the ceiling, and the ceiling is now set by the
// electronics rather than by a round number. wheeled_parameters.kcl carries that
// arithmetic and wheeled_electronics.kcl draws what it is holding.
//
// What it costs is lateral balance. Nothing can roll the torso over a wheel any
// more, so the robot leans only by driving the two wheels differentially. That
// trade is argued in docs/WHEELED_BIPED_ANALYSIS.md section 11 and taken here.
//
// Two other robots share these parts. walking_main.kcl beside this file is the
// eight-motor walking biped, which is the model on the `main` branch and still
// has hip roll and feet; the wheeled eight-motor robot this file used to hold
// is in the branch's history. What differs between all three is the top of the
// leg and the bottom of it; the limbs, the joint interface and the lid are one
// design throughout.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"
import prototypeWheelAxisHeight, wheeledKneeAxisHeight, wheeledHipPitchAxisHeight, wheeledShinCenterZ, wheeledThighCenterZ, wheeledTorsoCenterHeight from "wheeled_parameters.kcl"
import actuatorAssembly from "actuator.kcl"
import jointHardware from "hardware.kcl"
import thighRight, thighLeft from "thigh.kcl"
import shinRight, shinLeft from "shin.kcl"
import wheelRight, wheelLeft from "wheel.kcl"
import torsoAssembly from "torso.kcl"
import torsoPayload from "wheeled_electronics.kcl"

actuatorCopy2 = clone(actuatorAssembly)
actuatorCopy3 = clone(actuatorAssembly)
actuatorCopy4 = clone(actuatorAssembly)
actuatorCopy5 = clone(actuatorAssembly)
actuatorCopy6 = clone(actuatorAssembly)

// ---- actuators -------------------------------------------------------------


// Six, all with their axes across the robot. The hip roll pair, which were the
// only two turned fore-and-aft, are what this build deleted.


leftHipPitchMotor = actuatorAssembly
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(x = -hipCenterX, z = wheeledHipPitchAxisHeight, global = true)
leftKneeMotor = actuatorCopy2
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(x = -hipCenterX, z = wheeledKneeAxisHeight, global = true)
leftWheelMotor = actuatorCopy3
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(x = -hipCenterX, z = prototypeWheelAxisHeight, global = true)

rightHipPitchMotor = actuatorCopy4
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(x = hipCenterX, z = wheeledHipPitchAxisHeight, global = true)
rightKneeMotor = actuatorCopy5
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
  |> translate(x = hipCenterX, z = wheeledKneeAxisHeight, global = true)
rightWheelMotor = actuatorCopy6
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)
  |> translate(x = hipCenterX, z = prototypeWheelAxisHeight, global = true)

// ---- bearing carriers, bearings and journals -------------------------------
// Hip pitch is the only straddled joint left. Knee and wheel rely on the
// actuator's own output bearing, as they always did, and the two sets that used
// to sit at hip roll went with it.


leftHipPitchHardware = jointHardware()
  |> rotate(axis = [0, 0, 1], angle = 180deg, global = true)
  |> translate(x = -hipCenterX, z = wheeledHipPitchAxisHeight, global = true)
rightHipPitchHardware = jointHardware()
  |> translate(x = hipCenterX, z = wheeledHipPitchAxisHeight, global = true)

// ---- printed structure -----------------------------------------------------


// There is no hip carrier. The clevis that holds each hip pitch actuator is
// part of the pelvis now, so the printed chain from torso to wheel is torso,
// thigh, shin, wheel adapter.


leftThigh = thighLeft
  |> translate(x = -hipCenterX, z = wheeledThighCenterZ, global = true)
rightThigh = thighRight
  |> translate(x = hipCenterX, z = wheeledThighCenterZ, global = true)

leftShin = shinLeft
  |> translate(x = -hipCenterX, z = wheeledShinCenterZ, global = true)
rightShin = shinRight
  |> translate(x = hipCenterX, z = wheeledShinCenterZ, global = true)

leftWheel = wheelLeft
  |> translate(x = -hipCenterX, z = prototypeWheelAxisHeight, global = true)
rightWheel = wheelRight
  |> translate(x = hipCenterX, z = prototypeWheelAxisHeight, global = true)

bodyFrame = torsoAssembly
  |> translate(z = wheeledTorsoCenterHeight, global = true)
reservedPayload = torsoPayload
  |> translate(z = wheeledTorsoCenterHeight, global = true)

export robotAssembly = [
  bodyFrame,
  reservedPayload,
  leftHipPitchMotor,
  rightHipPitchMotor,
  leftKneeMotor,
  rightKneeMotor,
  leftWheelMotor,
  rightWheelMotor,
  leftHipPitchHardware,
  rightHipPitchHardware,
  leftThigh,
  rightThigh,
  leftShin,
  rightShin,
  leftWheel,
  rightWheel
]
