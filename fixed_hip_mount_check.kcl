// Isolated six-motor hip concept review scene
//
// Shows one right hip-pitch actuator inside the proposed fixed hanger. This is
// intentionally separate from wheeled_main.kcl; the full six-motor torso is not
// claimed until torso.kcl's hip-roll clevises/gussets have been properly removed
// and the hanger is integrated into the shell load path.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import actuatorAssembly from "actuator.kcl"
import fixedHipMountRight from "fixed_hip_mount.kcl"

reviewHipMotor = actuatorAssembly
  |> rotate(axis = [0, 1, 0], angle = 90deg, global = true)

export fixedHipMountCheck = [fixedHipMountRight, reviewHipMotor]
