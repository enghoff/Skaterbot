// Shin
// A stressed-shell limb spanning the knee and ankle joints. Identical to the
// thigh apart from its length; both come from limb.kcl.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"
import limbAssembly from "limb.kcl"

export shinAssembly = [limbAssembly(lowerLegLength)]
