// Thigh
// A flat-plate limb spanning the hip-pitch and knee joints. All of the geometry
// lives in limb.kcl and joint.kcl; the thigh only chooses its length and its
// hand.
//
// The robot is mirror-symmetric about its midline, so each leg segment exists
// in two hands. They are true mirrors, made with `mirror3d`, not spins: the
// stator plate's connector relief is not symmetric fore and aft, so spinning
// the part about its own axis would put the relief on the wrong side.
//
// `mirror3d` copies rather than transforms -- it leaves the original standing
// in the scene -- so the source is hidden afterwards. See docs/KCL_GOTCHAS.md.
//
// Both leg segments are 105 mm, so the right thigh and the left shin are the
// same print, and so are the left thigh and the right shin. There are still
// only two distinct limb parts on the robot.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"
import limbAssembly from "limb.kcl"

// limbAssembly builds the hand whose plate lies on +X, which is the right leg's
// thigh: its hip pitch actuator drives towards +X and its knee actuator, turned
// round, presents its rear cover the same way.
export thighRight = [limbAssembly(upperLegLength)]

thighMirrorSource = limbAssembly(upperLegLength)
export thighLeft = mirror3d(thighMirrorSource, across = YZ)
hide(thighMirrorSource)
