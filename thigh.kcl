// Thigh
// A stressed-shell limb spanning the hip-pitch and knee joints. All of the
// geometry lives in limb.kcl and joint.kcl; the thigh only chooses its length.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"
import limbAssembly from "limb.kcl"

export thighAssembly = [limbAssembly(upperLegLength)]
