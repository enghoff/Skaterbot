// The complete wheel: printed adapter, donor skate wheel, and the clamp that
// holds one to the other
//
// This is what the assemblies place at the end of a shin. The printed part on
// its own lives in wheel_adapter.kcl, because tools/mass.py measures each
// printed file standalone and would otherwise weigh the donor wheel as if it
// were PA12-CF.
//
// The stack outboard of the actuator's output face is: 24 mm of wheel, 2 mm of
// washer, 5 mm of M5 cap head. That last 7 mm is what makes the robot 208 mm
// wide across the screw heads against the walking robot's 161 mm across the
// feet. Nothing is near it -- it points into free air -- and the wider track is
// worth having on a machine that balances, but it is the number to quote for
// doorways and crates.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions and the shared drawing functions, reached through lib/main.kcl
import * from "lib/main.kcl"
import wheelAdapterRight, wheelAdapterLeft from "wheel_adapter.kcl"

washerInnerX = skateWheelOuterX
washerOuterX = washerInnerX + wheelClampWasherThickness
// M5 socket cap head, Ø8.5 x 5.
capHeadDiameter = 8.5mm
capHeadLength = 5mm

donorHub = skateWheelHub()
donorTread = skateWheelTread()

// ---- clamp washer and screw head -------------------------------------------


washerSketch = sketch(on = YZ) {
  washerCircle = circle(start = [var 15mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([washerCircle.center, ORIGIN])
  horizontal([
    washerCircle.center,
    washerCircle.start
  ])
  diameter(washerCircle) == wheelClampWasherDiameter
}
washerRegion = region(segments = [washerSketch.washerCircle])
washerRaw = extrude(washerRegion, length = wheelClampWasherThickness, symmetric = true)
  |> translate(x = washerInnerX + wheelClampWasherThickness / 2, global = true)

capHeadSketch = sketch(on = YZ) {
  capCircle = circle(start = [var 4.25mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([capCircle.center, ORIGIN])
  horizontal([capCircle.center, capCircle.start])
  diameter(capCircle) == capHeadDiameter
}
capHeadRegion = region(segments = [capHeadSketch.capCircle])
capHeadRaw = extrude(capHeadRegion, length = capHeadLength, symmetric = true)
  |> translate(x = washerOuterX + capHeadLength / 2, global = true)

hide(washerSketch)
hide(capHeadSketch)

clampHardware = appearance(
  [washerRaw, capHeadRaw],
  color = bearingSteel,
  roughness = 30,
  metalness = 90,
)

// The right-hand wheel matches a right wheel motor whose output points +X. The
// left motor is the mirrored installation, so the complete wheel is mirrored
// about the robot's mid-plane exactly as the walking feet were.
export wheelRight = [
  wheelAdapterRight,
  donorHub,
  donorTread,
  clampHardware
]

// The adapter brings its own mirrored hand from wheel_adapter.kcl, so only the
// bought parts are mirrored here. Mirroring the whole right wheel instead would
// leave wheelAdapterLeft unused, and an unused export is not an unused body:
// it would still stand in every scene that imported this file.
wheelMirrorSource = [
  clone(donorHub),
  clone(donorTread),
  clone(clampHardware)
]
mirroredDonor = mirror3d(wheelMirrorSource, across = YZ)
hide(wheelMirrorSource)

export wheelLeft = [wheelAdapterLeft, mirroredDonor]
