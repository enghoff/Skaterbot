// Torso payload reservation envelopes -- THE WALKING ROBOT'S
//
// Reserved volumes for power entry, the motor controllers, an optional SBC and
// the IMU. These are requirements, not geometry, and nothing may be designed
// through them.
//
// The wheeled robot has its own, in wheeled_electronics.kcl, because the two
// torsos are no longer the same box: this layout puts the power-entry block a
// whole storey below the rest, in the keel between the hip roll actuators, and
// the six-motor pelvis has no keel to put it in. That file also draws the boards
// rather than only reserving space for them, which is what a 65 mm torso needs
// and a 106 mm one did not.
//
// THERE IS NO BATTERY
// The robot is tethered: 24 V and CAN come in from the bench down one umbilical,
// which enters the back of the keel. Dropping the pack removes 190 g, but it
// does not empty the keel, because the pack was also the bus's energy store and
// the only thing on board able to absorb regeneration from eight backdrivable
// actuators. A tether cannot do either -- it has resistance and inductance, and
// a bench supply generally cannot sink current at all -- so a low-ESR bulk
// capacitor bank at the robot end stops being optional. The keel now reserves
// that bank together with the main fuse and the tether's terminal, as one
// power-entry block, 38 x 62 x 30 sitting at the bottom of the keel where it
// can be reached from underneath with the robot on its stand.
//
// The bank has NOT been sized. It needs the measured bus excursion from the
// actuator bench tests and the real tether length, so the volume here is a
// reservation and the 60 g in the mass table is an allowance.
//
// WHY THE LAYOUT IS THE SHAPE IT IS
// The earlier reservation was 92 x 34 x 32 lying across the torso, and it was
// never buildable: the hip roll actuators fill 278 to 324 mm at |x| between 25
// and 71, so a 92 mm-wide pack sat 21 mm inside both of them. The controller
// board clipped them by 13 mm as well, and the IMU was buried inside the
// controller. So the layout follows the space the actuators actually leave --
// power low in the keel, everything else stacked in the shell above the hip
// saddles, which begin at +10 in this frame.
//
// Coordinates are torso-local: the origin is the torso centre at 327 mm.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

powerEntrySketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 38mm, var 0mm])
  edge2 = line(start = [var 38mm, var 0mm], end = [var 38mm, var 62mm])
  edge3 = line(start = [var 38mm, var 62mm], end = [var 0mm, var 62mm])
  edge4 = line(start = [var 0mm, var 62mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == 38mm
  verticalDistance([edge2.start, edge2.end]) == 62mm
}
powerEntryRegion = region(
  segments = [
    powerEntrySketch.edge1,
    powerEntrySketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
// Low in the keel, between the hip roll actuators, entered from underneath. It
// sits below the tether slot in the keel's back wall, which spans -16 to -4, so
// the cable can turn and reach its terminal without crossing the bank.
powerEntryRaw = extrude(powerEntryRegion, length = 30mm, symmetric = true)
  |> translate(
       x = -19mm,
       y = -31mm,
       z = -36mm,
       global = true,
     )

controllerSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 76mm, var 0mm])
  edge2 = line(start = [var 76mm, var 0mm], end = [var 76mm, var 46mm])
  edge3 = line(start = [var 76mm, var 46mm], end = [var 0mm, var 46mm])
  edge4 = line(start = [var 0mm, var 46mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == 76mm
  verticalDistance([edge2.start, edge2.end]) == 46mm
}
controllerRegion = region(
  segments = [
    controllerSketch.edge1,
    controllerSketch.edge2
  ],
  intersectionIndex = -1,
  direction = CCW,
)
// Clear of the hip saddles, which top out at +10.
controllerRaw = extrude(controllerRegion, length = 12mm, symmetric = true)
  |> translate(
       x = -38mm,
       y = -23mm,
       z = 19mm,
       global = true,
     )

sbcSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 85mm, var 0mm])
  edge2 = line(start = [var 85mm, var 0mm], end = [var 85mm, var 58mm])
  edge3 = line(start = [var 85mm, var 58mm], end = [var 0mm, var 58mm])
  edge4 = line(start = [var 0mm, var 58mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == 85mm
  verticalDistance([edge2.start, edge2.end]) == 58mm
}
sbcRegion = region(segments = [sbcSketch.edge1, sbcSketch.edge2], intersectionIndex = -1, direction = CCW)
sbcRaw = extrude(sbcRegion, length = 16mm, symmetric = true)
  |> translate(
       x = -42.5mm,
       y = -29mm,
       z = 37mm,
       global = true,
     )

imuSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 22mm, var 0mm])
  edge2 = line(start = [var 22mm, var 0mm], end = [var 22mm, var 22mm])
  edge3 = line(start = [var 22mm, var 22mm], end = [var 0mm, var 22mm])
  edge4 = line(start = [var 0mm, var 22mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == 22mm
  verticalDistance([edge2.start, edge2.end]) == 22mm
}
imuRegion = region(segments = [imuSketch.edge1, imuSketch.edge2], intersectionIndex = -1, direction = CCW)
imuRaw = extrude(imuRegion, length = 6mm, symmetric = true)
  |> translate(
       x = -11mm,
       y = -11mm,
       z = 6mm,
       global = true,
     )

hide(powerEntrySketch)
hide(controllerSketch)
hide(sbcSketch)
hide(imuSketch)

powerEntryEnvelope = appearance(
  powerEntryRaw,
  color = "#7246a8",
  opacity = 55,
  roughness = 55,
  metalness = 0,
)
controllerEnvelope = appearance(
  controllerRaw,
  color = "#2f8a6d",
  opacity = 48,
  roughness = 50,
  metalness = 4,
)
sbcEnvelope = appearance(
  sbcRaw,
  color = "#3f6fac",
  opacity = 42,
  roughness = 50,
  metalness = 4,
)
imuEnvelope = appearance(
  imuRaw,
  color = "#e0c24c",
  opacity = 72,
  roughness = 42,
  metalness = 6,
)

export payloadEnvelopes = [
  powerEntryEnvelope,
  controllerEnvelope,
  sbcEnvelope,
  imuEnvelope
]
