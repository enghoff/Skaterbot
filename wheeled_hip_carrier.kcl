// Hip carriers for the wheeled robot, the pair
//
// All of the geometry lives in hip_carrier.kcl; this file only chooses the span
// between the two joint axes and makes the two hands, exactly as thigh.kcl and
// shin.kcl do over limb.kcl.
//
// The span is 51 mm rather than the walking robot's 55 mm, because the 80 mm
// wheel puts its axle 4 mm higher than the walking ankle while hip roll and the
// torso stay where they are. hip_carrier.kcl records what that does to the
// overlap between the two ends.
//
// The robot is mirror-symmetric about its midline, so this part exists left and
// right. `mirror3d` copies rather than transforms -- it leaves the original
// standing in the scene -- so the source is hidden afterwards. See
// docs/KCL_GOTCHAS.md.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import wheeledHipAxisOffset from "wheeled_parameters.kcl"
import hipCarrier from "hip_carrier.kcl"

export wheeledHipCarrierRight = hipCarrier(wheeledHipAxisOffset)

wheeledHipCarrierMirrorSource = hipCarrier(wheeledHipAxisOffset)
export wheeledHipCarrierLeft = mirror3d(wheeledHipCarrierMirrorSource, across = YZ)
hide(wheeledHipCarrierMirrorSource)
