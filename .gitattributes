# CAD geometry must round-trip byte-identical. core.autocrlf is true on the
# development machine, which would otherwise rewrite LF to CRLF on checkout and
# invalidate the checksums recorded in reference/README.md.
*.step  -text
*.STEP  -text
*.stl   -text
*.STL   -text
*.sldprt -text
*.SLDPRT -text

# KCL sources and prose keep normal handling, but pin the line ending so the
# repository looks the same on every platform.
*.kcl   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.py    text eol=lf
*.json  text eol=lf

# PDFs are binary; never eol-convert them
*.pdf -text
*.PDF -text

# The launch scripts at the project root. cmd.exe wants CRLF and sh chokes on a
# carriage return, so neither can be left to core.autocrlf.
*.cmd   text eol=crlf
*.sh    text eol=lf

# Trained policies: binary networks, kept byte for byte.
policies/**/exported/* -text
