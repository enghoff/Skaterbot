// Flat-plate limb
//
// One parametric limb, used for the thigh and the shin. It is a plate lying in
// a single plane: a Ø52 disc bolted flat to one actuator's rear cover, a Ø36
// disc bolted to the next actuator's output, and a channel waist between them.
// There is no clevis, no saddle and no closed shell, and nothing reaches around
// an actuator any more.
//
// Local frame: the limb axis is Z, both joint axes are X, and the two joint
// centres sit at z = +/- limbLength/2. The plate lies on the +X side with both
// actuators inboard of it. That works because the knee actuator is turned round
// -- see the note in parameters.kcl -- so the upper joint presents its output
// face and the lower joint presents its rear cover on the same side.
//
// A limb for the other hand is this one spun 180 degrees about Z, which is a
// true mirror here because every feature is symmetric fore and aft. thigh.kcl
// and shin.kcl each export both hands; and because the two leg segments are the
// same 105 mm, the right thigh and the left shin are the same print, as are the
// right shin and the left thigh. Two distinct limb parts, as before.
//
// The waist is a channel rather than a strip. A bare plate is sixty times
// softer sideways than the closed box this replaces, and the two flanges take
// that back to under a millimetre of sway for about 5 g. They point inboard,
// towards the joint axis, into space no actuator reaches: each body stops
// 29.5 mm from its own joint centre and the flanges stop at 25.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"
import outputDisc, statorPlate from "joint.kcl"

export fn limbAssembly(@limbLength) {
  jointZ = limbLength / 2

  waistSketch = sketch(on = XY) {
    edge1 = line(start = [var 0mm, var 0mm], end = [var 6mm, var 0mm])
    edge2 = line(start = [var 6mm, var 0mm], end = [var 6mm, var 30mm])
    edge3 = line(start = [var 6mm, var 30mm], end = [var 0mm, var 30mm])
    edge4 = line(start = [var 0mm, var 30mm], end = [var 0mm, var 0mm])
    coincident([edge1.start, ORIGIN])
    coincident([edge1.end, edge2.start])
    coincident([edge2.end, edge3.start])
    coincident([edge3.end, edge4.start])
    coincident([edge4.end, edge1.start])
    horizontal(edge1)
    vertical(edge2)
    horizontal(edge3)
    vertical(edge4)
    horizontalDistance([edge1.start, edge1.end]) == limbPlateThickness
    verticalDistance([edge2.start, edge2.end]) == limbWaistDepth
  }
  waistRegion = region(segments = [waistSketch.edge1, waistSketch.edge2], intersectionIndex = -1, direction = CCW)
  waistPlate = extrude(waistRegion, length = limbWaistHalfLength * 2, symmetric = true)
    |> translate(x = rotorHubInnerX, y = -(limbWaistDepth / 2), global = true)

  flangeSketch = sketch(on = XY) {
    edge1 = line(start = [var 0mm, var 0mm], end = [var 12mm, var 0mm])
    edge2 = line(start = [var 12mm, var 0mm], end = [var 12mm, var 4mm])
    edge3 = line(start = [var 12mm, var 4mm], end = [var 0mm, var 4mm])
    edge4 = line(start = [var 0mm, var 4mm], end = [var 0mm, var 0mm])
    coincident([edge1.start, ORIGIN])
    coincident([edge1.end, edge2.start])
    coincident([edge2.end, edge3.start])
    coincident([edge3.end, edge4.start])
    coincident([edge4.end, edge1.start])
    horizontal(edge1)
    vertical(edge2)
    horizontal(edge3)
    vertical(edge4)
    horizontalDistance([edge1.start, edge1.end]) == limbFlangeReach
    verticalDistance([edge2.start, edge2.end]) == limbFlangeThickness
  }
  flangeRegion = region(segments = [flangeSketch.edge1, flangeSketch.edge2], intersectionIndex = -1, direction = CCW)
  flangeFront = extrude(flangeRegion, length = limbFlangeHalfLength * 2, symmetric = true)
    |> translate(x = rotorHubInnerX - limbFlangeReach, y = limbWaistDepth / 2 - limbFlangeThickness, global = true)
  flangeRear = clone(flangeFront)
    |> translate(y = -(limbWaistDepth - limbFlangeThickness), global = true)

  upperDisc = outputDisc()
    |> translate(z = jointZ, global = true)
  // The stator plate is drawn behind an actuator whose output faces +X. This
  // limb's lower actuator is turned round, so the plate is spun to the near side
  // to land on the rear cover that now faces +X with everything else.
  lowerPlate = statorPlate()
    |> rotate(axis = [0, 0, 1], angle = 180deg, global = true)
    |> translate(z = -jointZ, global = true)

  hide(waistSketch)
  hide(flangeSketch)

  // Five interpenetrating bodies rather than one solid. The waist plate occupies
  // exactly the same band in X as both discs, which is the union the engine
  // refuses -- see docs/KCL_GOTCHAS.md -- and the flanges share a face with the
  // waist for the same reason. Every overlap is millimetres of real material, so
  // a slicer that merges coincident shells prints this as the single plate it
  // is. Verify that before printing.
  return appearance(
    [
      waistPlate,
      flangeFront,
      flangeRear,
      upperDisc,
      lowerPlate
    ],
    color = printedOrange,
    roughness = 70,
    metalness = 3,
  )
}
