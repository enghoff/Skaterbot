// Flat-plate limb
//
// One parametric limb, used for the thigh and the shin. It is a plate lying in
// a single plane: a Ø52 disc bolted flat to one actuator's rear cover, a Ø36
// disc bolted to the next actuator's output, and a channel waist between them.
// There is no clevis, no saddle and no closed shell, and nothing reaches around
// an actuator any more.
//
// Local frame: the limb axis is Z, both joint axes are X, and the two joint
// centres sit at z = +/- limbLength/2. The plate lies on the +X side with both
// actuators inboard of it. That works because the knee actuator is turned round
// -- see the note in parameters.kcl -- so the upper joint presents its output
// face and the lower joint presents its rear cover on the same side.
//
// A limb for the other hand is this one spun 180 degrees about Z, which is a
// true mirror here because every feature is symmetric fore and aft. thigh.kcl
// and shin.kcl each export both hands; and because the two leg segments are the
// same 105 mm, the right thigh and the left shin are the same print, as are the
// right shin and the left thigh. Two distinct limb parts, as before.
//
// The waist is a channel rather than a strip. A bare plate is sixty times
// softer sideways than the closed box this replaces, and the two flanges are
// what take that back. They stand on the plate's outboard face and point away
// from the joint axis, into open air. They used to point inboard, into the gap
// between the plate and the actuator, which is the one piece of space on the
// limb that anything else has to share. Outboard the only thing they can reach
// is the hip carrier's front cheek, and they stop clear of it.
//
// They do not stop above the lower joint any more. Set in far enough to miss
// the stator plate's rear bolts, they run on past both rows of that pattern and
// out over the disc, so the channel carries across the joint instead of handing
// its load to a bare plate a cap head short of it.
//
// The waist is not symmetric about the limb centre. Each end runs as far into
// its disc as that disc's bolt pattern allows, and the two patterns are not the
// same distance out, so the two ends are not either.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"
import outputDisc, statorPlate from "joint.kcl"

export fn limbAssembly(@limbLength) {
  jointZ = limbLength / 2

  // The waist reaches into both discs so the three bodies merge, but it cannot
  // reach the same distance at both ends. At the rotor end it stops where
  // parameters.kcl puts it, one counterbore clear of the Ø24 output circle. At
  // the stator end the Ø41 rear bolts are the constraint, and a waist symmetric
  // about the limb centre overshot them: its corner landed 0.7 mm from the two
  // bolt centres nearest the waist and filled 46 % of each hole, leaving a
  // 1.2 mm crescent no screw could pass. It now stops a cap head short of them,
  // which costs nothing structurally -- the plate is still 38 mm wide there, so
  // the section never narrows -- and leaves 8 mm of engagement into the disc.
  waistUpperZ = limbWaistUpperZ
  waistLowerZ = -(jointZ - actuatorRearBoltOffset - m3CapHeadStandoff)

  waistSketch = sketch(on = XY) {
    edge1 = line(start = [var 0mm, var 0mm], end = [var 6mm, var 0mm])
    edge2 = line(start = [var 6mm, var 0mm], end = [var 6mm, var 30mm])
    edge3 = line(start = [var 6mm, var 30mm], end = [var 0mm, var 30mm])
    edge4 = line(start = [var 0mm, var 30mm], end = [var 0mm, var 0mm])
    coincident([edge1.start, ORIGIN])
    coincident([edge1.end, edge2.start])
    coincident([edge2.end, edge3.start])
    coincident([edge3.end, edge4.start])
    coincident([edge4.end, edge1.start])
    horizontal(edge1)
    vertical(edge2)
    horizontal(edge3)
    vertical(edge4)
    horizontalDistance([edge1.start, edge1.end]) == limbPlateThickness
    verticalDistance([edge2.start, edge2.end]) == limbWaistDepth
  }
  waistRegion = region(segments = [waistSketch.edge1, waistSketch.edge2], intersectionIndex = -1, direction = CCW)
  waistPlate = extrude(waistRegion, length = waistUpperZ - waistLowerZ)
    |> translate(
         x = rotorHubInnerX,
         y = -(limbWaistDepth / 2),
         z = waistLowerZ,
         global = true,
       )

  // Where the flanges sit across the limb's depth is set by the stator plate's
  // rear bolts, not by the waist's edges. They used to stand on those edges at
  // y = +/-13, square over the four bolt centres at +/-14.5, and that only
  // worked because they stopped a cap head short of the near bolt row in Z and
  // so never reached the joint at all. Setting them in until their outer faces
  // clear the bolt centres by that same cap head lets them run straight past the
  // row instead.
  //
  // It costs some torsion, the channel being narrower, but no lateral stiffness
  // at all -- and lateral is the whole reason the flanges exist. That comes from
  // how far they stand off the plate in X, and in X they have not moved.
  flangeOuterY = actuatorRearBoltOffset - m3CapHeadStandoff
  flangeCenterY = flangeOuterY - (limbFlangeThickness / 2)

  // The lower end now stops a cap head past the FAR bolt row rather than a cap
  // head above the near one, so both rows of the four-bolt pattern are spanned
  // and the waist's stiffness is carried across the joint. The flange is backed
  // by solid the whole way: by the waist plate down to the waist's own end, and
  // by the stator disc from above that to well below here.
  //
  // The upper end is unchanged. It is the rotor end, and on the thigh the hip
  // carrier's front cheek stands 1 mm outboard of the plate there, so the flange
  // keeps a cheek radius and a millimetre away from that joint centre.
  //
  // Both ends run out into the plate on an arc of the flange's own reach rather
  // than stopping in a square shoulder, which is the whole of the profile's
  // curvature: two quarter arcs, tangent to the outer face at one end and to the
  // plate at the other.
  flangeBottomZ = -(jointZ + actuatorRearBoltOffset + m3CapHeadStandoff)
  flangeTopZ = jointZ - limbFlangeRotorClearance
  flangeHeight = flangeTopZ - flangeBottomZ

  // Two things about how this profile is written, both learned the hard way.
  // `arc` always sweeps counter-clockwise from its start to its end, so an arc
  // written the other way round comes back as three quarters of a circle rather
  // than a quarter, and the flange builds without complaint as a dumbbell -- a
  // disc at each end joined by a thin bar. And `region` traces its first segment
  // to where it meets its second and then turns that way at every corner, so the
  // two segments it is given have to touch and `direction` has to be the way the
  // outline is actually written. This one is written clockwise.
  flangeSketch = sketch(on = XZ) {
    rootFace = line(start = [var 0mm, var 0mm], end = [var 0mm, var 95.9mm])
    topBlend = arc(start = [var 0mm, var 95.9mm], end = [var 4.2mm, var 91.7mm], center = [var 4.2mm, var 95.9mm])
    outerFace = line(start = [var 4.2mm, var 91.7mm], end = [var 4.2mm, var 4.2mm])
    bottomBlend = arc(start = [var 4.2mm, var 4.2mm], end = [var 0mm, var 0mm], center = [var 4.2mm, var 0mm])
    coincident([rootFace.start, ORIGIN])
    coincident([rootFace.end, topBlend.start])
    coincident([topBlend.end, outerFace.start])
    coincident([outerFace.end, bottomBlend.start])
    coincident([bottomBlend.end, rootFace.start])
    vertical(rootFace)
    vertical(outerFace)
    verticalDistance([rootFace.start, rootFace.end]) == flangeHeight
    horizontalDistance([topBlend.start, topBlend.end]) == limbFlangeReach
    verticalDistance([topBlend.end, topBlend.start]) == limbFlangeBlendRadius
    horizontalDistance([bottomBlend.end, bottomBlend.start]) == limbFlangeReach
    verticalDistance([bottomBlend.end, bottomBlend.start]) == limbFlangeBlendRadius
  }
  flangeRegion = region(
    segments = [
      flangeSketch.rootFace,
      flangeSketch.topBlend
    ],
    direction = CW,
  )
  flangeFront = extrude(flangeRegion, length = limbFlangeThickness, symmetric = true)
    |> translate(
         x = rotorHubInnerX + limbPlateThickness,
         y = flangeCenterY,
         z = flangeBottomZ,
         global = true,
       )
  flangeRear = clone(flangeFront)
    |> translate(y = -(flangeCenterY * 2), global = true)

  // Where the waist runs into the hub disc there was a notch. The plate is
  // 30 mm wide and stops 14 mm below the joint centre; the O36 disc is only
  // 22.6 mm wide at that height, so the plate's top corners stood proud of the
  // disc with a re-entrant step between the two. That step sits exactly where
  // the limb hands its bending into the joint, which makes it the peak-stress
  // point on the part. These two gussets fill it and round the corner where the
  // plate's side runs on into the disc's rim.
  //
  // It cannot be done by simply raising the waist. The waist stops where it does
  // because 0.6 mm higher it would begin to cover the two lowest output
  // counterbores, and a covered counterbore is a bolt that cannot be fitted. So
  // the fill is local to each outer corner and stops a cap head clear of the
  // nearer counterbore centre in y.
  //
  // The fillet is tangent to the plate's side face and to the disc's rim, so its
  // centre lies one radius outboard of that face and one radius outside the
  // disc; where those two conditions cross fixes it. The inner edge runs back
  // from the disc tangency to the corner and is buried, because a chord between
  // two points of a disc stays inside it.
  gussetInnerY = actuatorOutputBoltCircle / 2 * cos(60deg) + m3CapHeadStandoff
  gussetOuterY = limbWaistDepth / 2
  gussetFilletRadius = limbPlateThickness / 2
  gussetFilletCenterY = gussetOuterY + gussetFilletRadius
  gussetDiscRadius = rotorHubDiameter / 2
  gussetFilletHypot = gussetDiscRadius + gussetFilletRadius
  gussetFilletDrop = sqrt(pow(gussetFilletHypot / 1mm, exp = 2) - pow(gussetFilletCenterY / 1mm, exp = 2)) * 1mm
  gussetFilletCenterZ = jointZ - gussetFilletDrop
  gussetTangentScale = gussetDiscRadius / gussetFilletHypot
  gussetTangentY = gussetFilletCenterY * gussetTangentScale
  gussetTangentZ = jointZ - (gussetFilletDrop * gussetTangentScale)

  // Drawn at the origin and translated into place, like every other sketch here.
  // The first version left the profile unanchored and relied on its seed points
  // for where it sat. That happened to solve correctly -- the measured volume
  // was the same either way -- but it was luck: an unanchored profile is free to
  // settle anywhere its constraints allow, and nothing would report it if it
  // did. The gusset measures 0.07 cm3 on its own against 0.075 predicted.
  //
  // Written clockwise, and the arc runs from the disc tangency back down to the
  // side face so that it sweeps counter-clockwise -- see the note on the flange
  // profile above, which was bitten by both of those. The arc's radius and its
  // tangency to the side face are pinned outright rather than left to the seed.
  gussetSketch = sketch(on = YZ) {
    innerEdge = line(start = [var 0mm, var 0mm], end = [var 6.03mm, var 4.73mm])
    filletFace = arc(start = [var 6.03mm, var 4.73mm], end = [var 5.6mm, var 3.18mm], center = [var 8.6mm, var 3.18mm])
    outerFace = line(start = [var 5.6mm, var 3.18mm], end = [var 5.6mm, var 0mm])
    rootEdge = line(start = [var 5.6mm, var 0mm], end = [var 0mm, var 0mm])
    coincident([innerEdge.start, ORIGIN])
    coincident([innerEdge.end, filletFace.start])
    coincident([filletFace.end, outerFace.start])
    coincident([outerFace.end, rootEdge.start])
    coincident([rootEdge.end, innerEdge.start])
    vertical(outerFace)
    horizontal(rootEdge)
    horizontal([filletFace.end, filletFace.center])
    horizontalDistance([filletFace.end, filletFace.center]) == gussetFilletRadius
    horizontalDistance([rootEdge.end, rootEdge.start]) == gussetOuterY - gussetInnerY
    verticalDistance([outerFace.end, outerFace.start]) == gussetFilletCenterZ - waistUpperZ
    horizontalDistance([innerEdge.start, innerEdge.end]) == gussetTangentY - gussetInnerY
    verticalDistance([innerEdge.start, innerEdge.end]) == gussetTangentZ - waistUpperZ
  }
  gussetRegion = region(
    segments = [
      gussetSketch.innerEdge,
      gussetSketch.filletFace
    ],
    direction = CW,
  )
  gussetFront = extrude(gussetRegion, length = limbPlateThickness, symmetric = true)
    |> translate(
         x = rotorHubInnerX + limbPlateThickness / 2,
         y = gussetInnerY,
         z = waistUpperZ,
         global = true,
       )
  gussetRear = mirror3d(gussetFront, across = XZ)

  upperDisc = outputDisc()
    |> translate(z = jointZ, global = true)
  // The stator plate is drawn behind an actuator whose output faces +X. This
  // limb's lower actuator is turned round, so the plate is spun to the near side
  // to land on the rear cover that now faces +X with everything else.
  lowerPlate = statorPlate()
    |> rotate(axis = [0, 0, 1], angle = 180deg, global = true)
    |> translate(z = -jointZ, global = true)

  hide(waistSketch)
  hide(flangeSketch)
  hide(gussetSketch)

  // Five interpenetrating bodies rather than one solid. The waist plate occupies
  // exactly the same band in X as both discs, which is the union the engine
  // refuses -- see docs/KCL_GOTCHAS.md -- and the flanges share a face with the
  // waist for the same reason. Every overlap is millimetres of real material, so
  // a slicer that merges coincident shells prints this as the single plate it
  // is. Verify that before printing.
  return appearance(
    [
      waistPlate,
      flangeFront,
      flangeRear,
      gussetFront,
      gussetRear,
      upperDisc,
      lowerPlate
    ],
    color = printedOrange,
    roughness = 70,
    metalness = 3,
  )
}
