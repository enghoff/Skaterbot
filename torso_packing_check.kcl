// How the torso packs, with the lid off
//
// The 65 mm torso is sized by its contents rather than by a round number, so
// "does it fit" is a question about this scene and not about a table. It shows
// the pelvis with its cover hidden and the four payload items standing in it,
// each inside the reservation it has to stay within.
//
// WHAT TO LOOK FOR, from the bottom up:
//
// * the IMU on the shell floor, in the 51.5 mm of clear floor between the two
// hip pitch saddles -- the only item narrow enough to use that space;
// * the power-entry block and the controller carrier side by side on the saddle
// tops, with about 2 mm between them and 2 mm to each side wall. That pair is
// why the shell is 125 mm wide rather than 118;
// * the SBC over both of them, because at 85 mm it is wider than the gap either
// leaves, with its connector bank facing forward and away from the tether.
//
// The cover is imported only so it can be hidden: importing any name from a
// module runs the whole module, so the lid would otherwise sit over the scene
// this exists to look into.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions and the shared drawing functions, reached through lib/main.kcl
import wheeledTorsoCenterHeight from "lib/main.kcl"
import pelvisShell, torsoCover from "torso.kcl"
import torsoPayload from "wheeled_electronics.kcl"

hide(torsoCover)

packedPelvis = pelvisShell
  |> translate(z = wheeledTorsoCenterHeight, global = true)
packedPayload = torsoPayload
  |> translate(z = wheeledTorsoCenterHeight, global = true)

export torsoPackingCheck = [packedPelvis, packedPayload]
