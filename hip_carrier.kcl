// Hip roll to hip pitch carrier
// Short printed bridge linking the orthogonal joint modules without cantilevering the pitch motor.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import * from "parameters.kcl"

axisHalfOffset = hipAxisOffset / 2
railWidth = 8mm
railDepth = 12mm
railLength = hipAxisOffset - 11mm
railCenterOffset = 15mm
bridgeWidth = 40mm
bridgeDepth = 18mm
bridgeHeight = 6mm

hubSketch = sketch(on = XZ) {
  hubCircle = circle(start = [var 15mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([hubCircle.center, ORIGIN])
  horizontal([hubCircle.center, hubCircle.start])
  diameter(hubCircle) == 30mm
}
hubRegion = region(segments = [hubSketch.hubCircle])
rollOutputHubRaw = extrude(hubRegion, length = 12mm, symmetric = true)
  |> translate(z = axisHalfOffset, global = true)

railSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 8mm, var 0mm])
  edge2 = line(start = [var 8mm, var 0mm], end = [var 8mm, var 12mm])
  edge3 = line(start = [var 8mm, var 12mm], end = [var 0mm, var 12mm])
  edge4 = line(start = [var 0mm, var 12mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == railWidth
  verticalDistance([edge2.start, edge2.end]) == railDepth
}
railRegion = region(segments = [railSketch.edge1, railSketch.edge2], intersectionIndex = -1, direction = CCW)
leftRailRaw = extrude(railRegion, length = railLength, symmetric = true)
  |> translate(x = -railCenterOffset - (railWidth / 2), y = -railDepth / 2, global = true)
rightRailRaw = clone(leftRailRaw)
  |> translate(x = railCenterOffset * 2, global = true)

bridgeSketch = sketch(on = XY) {
  edge1 = line(start = [var 0mm, var 0mm], end = [var 40mm, var 0mm])
  edge2 = line(start = [var 40mm, var 0mm], end = [var 40mm, var 18mm])
  edge3 = line(start = [var 40mm, var 18mm], end = [var 0mm, var 18mm])
  edge4 = line(start = [var 0mm, var 18mm], end = [var 0mm, var 0mm])
  coincident([edge1.start, ORIGIN])
  coincident([edge1.end, edge2.start])
  coincident([edge2.end, edge3.start])
  coincident([edge3.end, edge4.start])
  coincident([edge4.end, edge1.start])
  horizontal(edge1)
  vertical(edge2)
  horizontal(edge3)
  vertical(edge4)
  horizontalDistance([edge1.start, edge1.end]) == bridgeWidth
  verticalDistance([edge2.start, edge2.end]) == bridgeDepth
}
bridgeRegion = region(segments = [bridgeSketch.edge1, bridgeSketch.edge2], intersectionIndex = -1, direction = CCW)
pitchBridgeRaw = extrude(bridgeRegion, length = bridgeHeight, symmetric = true)
  |> translate(
       x = -bridgeWidth / 2,
       y = -bridgeDepth / 2,
       z = -axisHalfOffset + 4mm,
       global = true,
     )

hide(hubSketch)
hide(railSketch)
hide(bridgeSketch)

rollOutputHub = appearance(
  rollOutputHubRaw,
  color = printedOrange,
  roughness = 72,
  metalness = 2,
)
leftRail = appearance(
  leftRailRaw,
  color = printedDark,
  roughness = 70,
  metalness = 3,
)
rightRail = appearance(
  rightRailRaw,
  color = printedDark,
  roughness = 70,
  metalness = 3,
)
pitchBridge = appearance(
  pitchBridgeRaw,
  color = printedOrange,
  roughness = 72,
  metalness = 2,
)

export hipCarrierAssembly = [
  rollOutputHub,
  leftRail,
  rightRail,
  pitchBridge
]
