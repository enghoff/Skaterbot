// Knee 100-degree pre-limit review
// Thigh held upright with the shin just short of the commissioning limit, so the shin's
// plate can be checked against the thigh's. They lie in different planes
// now, on opposite sides of the knee actuator, so nothing can touch.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

// Dimensions and the shared drawing functions, reached through lib/main.kcl
import * from "lib/main.kcl"
import actuatorAssembly from "actuator.kcl"
import thighRight from "thigh.kcl"
import shinRight from "shin.kcl"

kneePreLimitAngle = 100deg
shinPreLimitAngle = -kneePreLimitAngle
upperLinkCenterZ = upperLegLength / 2
lowerLinkCenterY = lowerLegLength / 2 * sin(shinPreLimitAngle)
lowerLinkCenterZ = -lowerLegLength / 2 * cos(shinPreLimitAngle)

reviewMotor = actuatorAssembly
  |> rotate(axis = [0, 1, 0], angle = -90deg, global = true)
reviewThigh = thighRight
  |> translate(z = upperLinkCenterZ, global = true)
reviewShin = shinRight
  |> rotate(axis = [1, 0, 0], angle = shinPreLimitAngle, global = true)
  |> translate(y = lowerLinkCenterY, z = lowerLinkCenterZ, global = true)

export kneePreLimitAssembly = [reviewMotor, reviewThigh, reviewShin]
