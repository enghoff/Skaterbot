# Zoo Design Studio
thumbnail.png

# Local credentials — never commit
secrets/
*.env

# Rendered views from tools/views.py
renders/

# Python bytecode from tools/
__pycache__/

# Exported geometry
*.stl
*.step
*.STEP

# Vendor reference geometry is tracked on purpose — it is an input, not an export
!reference/**/*.step
!reference/**/*.STEP
!reference/**/*.stl

# The simulation meshes are tracked for the same reason: they are what the URDF
# points at, so a checkout can be simulated without spending engine credits to
# re-export them. simulation/meshes/ is the raw engine output and stays ignored;
# simulation/urdf/meshes/ holds the binary copies build_urdf.py writes.
!simulation/urdf/meshes/*.stl
*.FCStd~
.DS_Store

# Transient wrapper scene written by tools/export.py
_export_piece.kcl

# The rigged Isaac Sim robot, written by simulation/isaacsim/import_urdf.py from
# the URDF. Generated output, and it embeds the meshes, so it is rebuilt rather
# than tracked.
simulation/isaacsim/usd/
