# Local credentials — never commit
secrets/
*.env

# Rendered views, from the metered tools/views.py the migration deleted. Kept
# ignored because the directory is still on disk in some checkouts.
renders/

# Python bytecode
__pycache__/
.ruff_cache/

# Exported geometry
*.stl
*.step
*.STEP

# Vendor reference geometry is tracked on purpose — it is an input, not an export
!reference/**/*.step
!reference/**/*.STEP
!reference/**/*.stl

# The simulation meshes are tracked for the same reason: they are what the URDF
# points at, so a checkout can be simulated without spending engine credits to
# re-export them. simulation/meshes/ is the raw engine output and stays ignored;
# simulation/urdf/meshes/ holds the binary copies build_urdf.py writes.
!simulation/urdf/meshes/*.stl
*.FCStd~
.DS_Store

# The rigged Isaac Sim robot, written by simulation/isaacsim/import_urdf.py from
# the URDF. Generated output, and it embeds the meshes, so it is rebuilt rather
# than tracked.
simulation/isaacsim/usd/

# Obsidian's per-vault workspace state, written into docs/ when the notes are
# opened as a vault. Editor settings, not project content.
.obsidian/

# Export records. tools/export.py writes a manifest.json beside whatever it
# wrote, as a record of that run rather than as an input, and it goes stale
# against the part set. exports/ and simulation/meshes/ are output directories
# entire; only the meshes the URDF points at are tracked, not the record.
exports/
simulation/meshes/
simulation/urdf/meshes/manifest.json

# Fabrication output. KiCad plots the gerbers and drill files from
# electrical/kicad/carrier.kicad_pcb, so they are a render of a tracked input
# and go stale against it. Regenerate them rather than committing them.
electrical/kicad/gerber/
electrical/kicad/carrier-fabrication.zip

# What electrical/power_pcb.py hands to KiCad and reads back from it: the board
# description it writes for the builder, the pad positions it checks against, and
# KiCad's own DRC report. All three are a record of one run, where the board and
# the project file beside them are the design and are tracked.
electrical/kicad_power/power_board.json
electrical/kicad_power/pads.json
electrical/kicad_power/drc.json

# KiCad's own per-user state, written beside the project whenever the GUI opens
# it. carrier.kicad_prl is which layer you were last looking at, .history/ is
# the editor's automatic snapshots, and the ~*.lck files say the project is open
# on this machine right now. None of it is the design.
electrical/kicad/*.kicad_prl
electrical/kicad_power/*.kicad_prl
electrical/kicad/.history/
electrical/kicad/~*.lck
electrical/kicad_power/.history/
electrical/kicad_power/~*.lck

# Firmware build output. cargo writes everything under target/, and flash.ps1
# copies the ELF there with the extension the programmer needs. The firmware is
# one workspace now; firmware/*/target/ is where each crate built before that.
firmware/target/
firmware/*/target/

# The policy's weights, which firmware/policy/export.py writes from a run in
# exports/, and exports/ is not tracked either.
firmware/policy/net/
